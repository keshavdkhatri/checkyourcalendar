---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Optional search parameter to show mock results
const searchQuery = Astro.url.searchParams.get('q') || '';
---

<Layout title="Search" description="Search for specific calendar dates, religious festivals, fasting days, and historical stories.">
  <Header activeTab="search" />

  <main class="container main-content">
    <section class="search-header">
      <h1 class="page-title">Search Directory</h1>
      <p class="page-intro">Find calculations, observance rules, and cultural background for any date or event.</p>
    </section>

    <!-- Search Form -->
    <section class="search-form-section">
      <form action="/search" method="GET" class="search-form-bar">
        <span class="material-symbols-outlined input-icon">search</span>
        <input 
          type="search" 
          name="q" 
          placeholder="Search for 'Diwali', 'August 24', 'Hijri', etc..." 
          class="main-search-input" 
          value={searchQuery}
          aria-label="Search site content"
          required
        />
        <button type="submit" class="submit-btn">Search</button>
      </form>
    </section>

    <!-- Search Results / Empty State -->
    <section class="results-section">
      {searchQuery ? (
        <div class="results-container">
          <h2 class="results-heading">Results for "{searchQuery}"</h2>
          
          <div class="results-list">
            <!-- Mock result item -->
            <div class="result-card">
              <span class="result-type">Story</span>
              <h3 class="result-title">
                <a href="/story/putrada-ekadashi">The Legend of Putrada Ekadashi</a>
              </h3>
              <p class="result-excerpt">The ancient narrative of King Mahajit and the seekers of blessing on the Shravana Shukla Ekadashi lunar day...</p>
            </div>
            
            <div class="result-card">
              <span class="result-type">Observance</span>
              <h3 class="result-title">
                <a href="/observance/putrada-ekadashi">Shravan Putrada Ekadashi</a>
              </h3>
              <p class="result-excerpt">Fasting / Vrat observed on the 11th lunar day of the bright fortnight in the Vikram Samvat calendar.</p>
            </div>
          </div>
        </div>
      ) : (
        <div class="empty-state">
          <span class="material-symbols-outlined empty-icon">manage_search</span>
          <h2 class="empty-title">Start exploring</h2>
          <p class="empty-description">Enter a search term above to look up dates, religious festivals, fasting cycles, or cultural stories.</p>
          
          <!-- Suggested Search Topics -->
          <div class="suggestions-box">
            <span class="suggestions-label">Try searching:</span>
            <div class="suggestions-list">
              <a href="/search?q=Putrada+Ekadashi" class="suggestion-link">Putrada Ekadashi</a>
              <a href="/search?q=Hijri" class="suggestion-link">Hijri Calendar</a>
              <a href="/search?q=Yom+Kippur" class="suggestion-link">Yom Kippur</a>
            </div>
          </div>
        </div>
      )}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .search-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Form Bar */
  .search-form-section {
    width: 100%;
  }

  .search-form-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .search-form-bar:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-container);
  }

  .input-icon {
    color: var(--color-on-surface-variant);
  }

  .main-search-input {
    border: none;
    background: transparent;
    width: 100%;
    color: var(--color-on-surface);
    font-size: 1rem;
    outline: none;
  }

  .submit-btn {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
    cursor: pointer;
  }

  .submit-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  /* Results styling */
  .results-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .results-heading {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-on-surface-variant);
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .result-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .result-type {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-secondary);
    letter-spacing: 0.05em;
  }

  .result-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--color-primary);
  }

  .result-title a:hover {
    text-decoration: underline;
  }

  .result-excerpt {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
  }

  /* Empty state styling */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-xl) 0;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-outline-variant);
    border-radius: var(--radius-xl);
    gap: var(--spacing-sm);
  }

  .empty-icon {
    font-size: 4rem !important;
    color: var(--color-outline-variant);
  }

  .empty-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-on-surface);
  }

  .empty-description {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    max-width: 500px;
    line-height: 1.5;
  }

  .suggestions-box {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .suggestions-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    letter-spacing: 0.05em;
  }

  .suggestions-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-xs);
  }

  .suggestion-link {
    background-color: var(--color-surface-dim);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-full);
    padding: 4px 12px;
    font-size: 0.8125rem;
    color: var(--color-primary);
  }

  .suggestion-link:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
    border-color: var(--color-primary);
  }
</style>
