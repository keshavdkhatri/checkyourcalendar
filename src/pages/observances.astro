---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ObservanceCard from '../components/ObservanceCard.astro';
import { mockObservances } from '../data/mockData';
---

<Layout title="Observances - Directory" description="Explore the global calendar of festivals, fasting days, holy days, and commemorations.">
  <Header activeTab="observances" />

  <main class="container main-content">
    <section class="explorer-header">
      <h1 class="page-title">Observances</h1>
      <p class="page-intro">
        Browse the global directory of observances. Explore details of festivals, fasting periods, national days, and international commemorations celebrated across different traditions and calendar systems.
      </p>
    </section>

    <!-- Filter chips -->
    <div class="filters-container">
      <span class="filter-label">Filter by type:</span>
      <div class="filter-chips">
        <button class="chip active">All</button>
        <button class="chip">Festivals</button>
        <button class="chip">Fasting Days</button>
        <button class="chip">Commemorations</button>
        <button class="chip">Public Holidays</button>
      </div>
    </div>

    <!-- Observances list -->
    <section class="observances-grid">
      {mockObservances.map(obs => (
        <ObservanceCard 
          id={obs.id}
          name={obs.name}
          type={obs.type}
          calendarName={obs.calendarName}
          regionName={obs.regionName}
          summary={obs.summary}
          storyRef={obs.storyRef}
        />
      ))}
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .explorer-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Filters styling */
  .filters-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-md);
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    letter-spacing: 0.05em;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .chip {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .chip:hover {
    background-color: var(--color-surface-dim);
    border-color: var(--color-outline-variant);
  }

  .chip.active {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  /* Observances list grid */
  .observances-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .observances-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
