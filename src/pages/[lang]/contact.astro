---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

export async function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const labels = {
  hi: {
    title: 'संपर्क करें',
    intro: 'क्या आपके पास कोई सुझाव है, कोई विसंगति देखी है, या कोई सांस्कृतिक पर्व जोड़ना चाहते हैं? हम आपके सुझावों का स्वागत करते हैं।',
    cardTitle: 'ईमेल द्वारा संपर्क करें',
    cardDesc: 'हम सभी पूछताछ, कैलेंडर सुधार और पर्वों के सुझाव सीधे ईमेल द्वारा प्राप्त करते हैं। नीचे दिए गए बटन पर क्लिक करने पर आपका ईमेल ऐप खुल जाएगा।',
    sendEmail: 'ईमेल भेजें',
    copyEmailLabel: 'या हमारा ईमेल पता कॉपी करें:',
    whatToInclude: 'ईमेल में क्या शामिल करें',
    topicCorrectionTitle: 'कैलेंडर विसंगति व सुधार',
    topicCorrectionDesc: 'कृपया संबंधित कैलेंडर प्रणाली, विशिष्ट तिथि और पंचांग या खगोलीय संदर्भ शामिल करें।',
    topicSuggestionTitle: 'पर्व व त्योहार का सुझाव',
    topicSuggestionDesc: 'कृपया त्योहार का नाम, कैलेंडर प्रणाली, तिथि/नियम और सांस्कृतिक महत्व साझा करें।',
    topicFeedbackTitle: 'सामान्य प्रतिक्रिया व तकनीकी समस्या',
    topicFeedbackDesc: 'अपने सुझाव, गणना पद्धति से जुड़े प्रश्न या साइट से संबंधित तकनीकी समस्या साझा करें।',
    sidebarTitle: 'कैलेंडर डेटा संबंधी महत्वपूर्ण टिप्पणी',
    sidebarText: 'कैलेंडर नियम खगोलीय चक्रों और विभिन्न परंपराओं पर आधारित होते हैं। सुधार का सुझाव देते समय कृपया शामिल करें:',
    sidebarItem1: 'संबंधित कैलेंडर प्रणाली',
    sidebarItem2: 'तिथि और अपेक्षित पर्व',
    sidebarItem3: 'प्रमाणित स्रोत या पंचांग संदर्भ',
    directContact: 'सीधा संपर्क',
    directText: 'संपादकीय और तकनीकी पूछताछ के लिए:'
  },
  gu: {
    title: 'સંપર્ક કરો',
    intro: 'શું આપની પાસે કોઈ પ્રતિસાદ છે, કેલેન્ડરમાં કોઈ ક્ષતિ જણાઈ છે, કે કોઈ તહેવાર ઉમેરવા માંગો છો? અમે આપના દરેક સંદેશનું સ્વાગત કરીએ છીએ.',
    cardTitle: 'ઈમેલ દ્વારા અમારો સંપર્ક કરો',
    cardDesc: 'અમે તમામ પૂછપરછ, કેલેન્ડર સુધારા અને પર્વોના સૂચનો સીધા ઈમેલ દ્વારા સ્વીકારીએ છીએ. નીચેના બટન પર ક્લિક કરવાથી આપનું ઈમેલ એપ ખૂલશે.',
    sendEmail: 'ઈમેલ મોકલો',
    copyEmailLabel: 'અથવા અમારું ઈમેલ સરનામું કોપી કરો:',
    whatToInclude: 'ઈમેલમાં કઈ વિગતો આપવી',
    topicCorrectionTitle: 'કેલેન્ડર ક્ષતિ અને સુધારો',
    topicCorrectionDesc: 'કૃપા કરીને સંબંધિત કેલેન્ડર પ્રણાલી, ચોક્કસ તારીખ અને પંચાંગ અથવા ખગોળીય સંદર્ભ જણાવો.',
    topicSuggestionTitle: 'તહેવાર કે વ્રતનું સૂચન',
    topicSuggestionDesc: 'કૃપા કરીને તહેવારનું નામ, કેલેન્ડર પદ્ધતિ, તિથિ/નિયમ અને સાંસ્કૃતિક મહત્વ શેર કરો.',
    topicFeedbackTitle: 'સામાન્ય પ્રતિભાવ અને ટેકનિકલ પ્રશ્નો',
    topicFeedbackDesc: 'આપના સૂચનો, ગણતરી પદ્ધતિ અંગેના પ્રશ્નો કે વેબસાઇટ વપરાશ અંગેનો પ્રતિભાવ આપો.',
    sidebarTitle: 'કેલેન્ડર માહિતી અંગે મહત્વપૂર્ણ નોંધ',
    sidebarText: 'સમયગણનાના નિયમો ખગોળીય ચક્રો અને વિવિધ પરંપરાઓ પર આધારિત હોય છે. સુધારો સૂચવતી વખતે કૃપા કરીને વિગતો આપો:',
    sidebarItem1: 'સંબંધિત કેલેન્ડર પ્રણાલી',
    sidebarItem2: 'તારીખ અને અપેક્ષિત તહેવાર',
    sidebarItem3: 'પ્રમાણિત સ્ત્રોત અથવા પંચાંગ સંદર્ભ',
    directContact: 'સીધો સંપર્ક',
    directText: 'સંપાદકીય અને ટેકનિકલ પૂછપરછ માટે:'
  }
}[lang];
---

<Layout 
  title={t.contact.title} 
  description={t.contact.metaDesc}
  lang={lang}
>
  <Header activeTab="contact" lang={lang} />

  <main class="container main-content">
    <section class="contact-section">
      <div class="contact-header">
        <h1 class="page-title">{labels.title}</h1>
        <p class="page-intro">
          {labels.intro}
        </p>
      </div>

      <div class="contact-grid">
        <!-- Main Contact Card -->
        <div class="contact-card">
          <div class="card-header-group">
            <h2 class="card-title">{labels.cardTitle}</h2>
            <p class="card-desc">
              {labels.cardDesc}
            </p>
          </div>

          <div class="action-group">
            <a 
              href="mailto:inquiries@checkyourcalendar.com" 
              class="email-btn"
              aria-label={`inquiries@checkyourcalendar.com (${labels.sendEmail})`}
            >
              <span class="material-symbols-outlined btn-icon" aria-hidden="true">mail</span>
              <span>{labels.sendEmail}</span>
            </a>
          </div>

          <div class="email-address-box">
            <span class="email-label">{labels.copyEmailLabel}</span>
            <a href="mailto:inquiries@checkyourcalendar.com" class="email-address-value">inquiries@checkyourcalendar.com</a>
          </div>

          <div class="topics-guide">
            <h3 class="guide-title">{labels.whatToInclude}</h3>
            <div class="guide-grid">
              <div class="guide-item">
                <strong>{labels.topicCorrectionTitle}</strong>
                <p>{labels.topicCorrectionDesc}</p>
              </div>
              <div class="guide-item">
                <strong>{labels.topicSuggestionTitle}</strong>
                <p>{labels.topicSuggestionDesc}</p>
              </div>
              <div class="guide-item">
                <strong>{labels.topicFeedbackTitle}</strong>
                <p>{labels.topicFeedbackDesc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Sidebar -->
        <aside class="info-sidebar">
          <div class="info-card">
            <h2 class="sidebar-title">{labels.sidebarTitle}</h2>
            <p class="sidebar-text">
              {labels.sidebarText}
            </p>
            <ul class="sidebar-list">
              <li>{labels.sidebarItem1}</li>
              <li>{labels.sidebarItem2}</li>
              <li>{labels.sidebarItem3}</li>
            </ul>
          </div>
          
          <div class="info-card border-only">
            <h2 class="sidebar-title">{labels.directContact}</h2>
            <p class="sidebar-text">
              {labels.directText}
              <br />
              <a href="mailto:inquiries@checkyourcalendar.com" class="sidebar-email">
                <strong>inquiries@checkyourcalendar.com</strong>
              </a>
            </p>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .contact-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Grid Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .contact-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .card-header-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  .action-group {
    padding-top: var(--spacing-xs);
  }

  .email-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .email-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  .email-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-icon {
    font-size: 1.25rem !important;
  }

  .email-address-box {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface-dim);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs) var(--spacing-sm);
  }

  .email-label {
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
  }

  .email-address-value {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.9375rem;
    user-select: all;
  }

  .email-address-value:hover {
    color: var(--color-primary-container);
  }

  .topics-guide {
    margin-top: var(--spacing-sm);
    border-top: 1px solid var(--color-outline-variant);
    padding-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .guide-grid {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .guide-item {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }

  .guide-item strong {
    color: var(--color-on-surface);
    display: block;
    margin-bottom: 2px;
    font-size: 0.875rem;
  }

  .guide-item p {
    margin: 0;
  }

  /* Sidebar styling */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .info-card {
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }

  .info-card.border-only {
    background-color: transparent;
    border: 1px dashed var(--color-outline-variant);
  }

  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-text {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .sidebar-email {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sidebar-email:hover {
    color: var(--color-primary-container);
  }

  .sidebar-list {
    margin-top: var(--spacing-sm);
    padding-left: var(--spacing-md);
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
