---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

export async function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const faqList = {
  hi: [
    {
      q: 'विभिन्न कैलेंडर प्रणालियों में आज की तारीख कैसे देखें और तुलना करें?',
      a: [
        'जब आप CheckYourCalendar खोलते हैं, तो होमपेज स्वचालित रूप से आपकी स्थानीय तिथि का पता लगाता है और सभी समर्थित कैलेंडर प्रणालियों में एक साथ आज की तारीख प्रदर्शित करता है। सौर, चांद्र और चांद्र-सौर परंपराओं में आज की तिथि के साथ-साथ, यह पृष्ठ आज आने वाले प्रमुख सांस्कृतिक या धार्मिक पर्वों को भी दर्शाता है। आप किसी भी विशिष्ट तिथि को चुनकर विश्व की विभिन्न परंपराओं में उसके निर्देशांक भी देख सकते हैं।'
      ]
    },
    {
      q: 'CheckYourCalendar किन कैलेंडर प्रणालियों का समर्थन करता है?',
      a: [
        'CheckYourCalendar वर्तमान में मानक ग्रेगोरियन कैलेंडर के साथ ८ प्रमुख ऐतिहासिक, धार्मिक और नागरिक कैलेंडर प्रणालियों के लिए तिथि रूपांतरण और सांस्कृतिक संदर्भ प्रदान करता है: विक्रम संवत (गुजराती/हिंदू), इस्लामी हिजरी, हिब्रू, सौर हिजरी (फ़ारसी), भारतीय राष्ट्रीय पंचांग (शक संवत), चीनी पारंपरिक (चांद्र-सौर), कॉप्टिक और इथियोपियाई कैलेंडर। समय के साथ अन्य कैलेंडर प्रणालियों को भी जोड़ा जा सकता है।'
      ]
    },
    {
      q: 'विभिन्न काल-गणना प्रणालियों के बीच कैलेंडर रूपांतरण कैसे कार्य करता है?',
      a: [
        'प्रत्येक कैलेंडर प्रणाली समय को एक विशिष्ट ऐतिहासिक आरंभ बिंदु (युग/Epoch) से मापती है और विशिष्ट खगोलीय या नागरिक नियमों का पालन करती है। कैलेंडर रूपांतरण किसी तिथि को एक मानकीकृत सार्वभौमिक समय निर्देशांक में बदलकर कार्य करता है, और फिर प्रमाणित खगोलीय सूत्रों और एल्गोरिदम का उपयोग करके लक्षित कैलेंडर में संबंधित वर्ष, माह, दिवस और चक्र की गणना करता है।'
      ]
    },
    {
      q: 'सौर, चांद्र और चांद्र-सौर कैलेंडर प्रणालियों में क्या अंतर है?',
      a: [
        'कैलेंडर प्रणालियों को उनके द्वारा अनुसरण किए जाने वाले खगोलीय चक्रों के आधार पर वर्गीकृत किया जाता है:',
        'सौर कैलेंडर (जैसे ग्रेगोरियन, फ़ारसी और भारतीय शक संवत) पृथ्वी की सूर्य परिक्रमा (~३६५.२४ दिन) का अनुसरण करते हैं ताकि तिथियां सौर ऋतुओं के साथ संरेखित रहें।',
        'विशुद्ध चांद्र कैलेंडर (जैसे इस्लामी हिजरी कैलेंडर) १२ चंद्र कला चक्रों (~३५४ दिन) का अनुसरण करते हैं, जिससे तिथियां लगभग ३३ वर्षों के चक्र में सभी चार ऋतुओं में घूमती हैं।',
        'चांद्र-सौर कैलेंडर (जैसे हिंदू विक्रम संवत, हिब्रू और चीनी कैलेंडर) चंद्र मासों का अनुसरण करते हैं और सौर वर्ष के साथ सामंजस्य बनाए रखने के लिए समय-समय पर एक अधिक मास (लीप मंथ) जोड़ते हैं।'
      ]
    },
    {
      q: 'एक ही दिन के लिए अलग-अलग कैलेंडरों में वर्ष और तारीखें भिन्न क्यों होती हैं?',
      a: [
        'विभिन्न संस्कृतियों ने अपने कैलेंडरों को अपने प्रारंभिक वर्ष (युग) के रूप में विभिन्न ऐतिहासिक, खगोलीय या आध्यात्मिक मील के पत्थरों से जोड़ा है। उदाहरण के लिए, ग्रेगोरियन कैलेंडर सामान्य युग (CE) का उपयोग करता है, जबकि विक्रम संवत, इस्लामी हिजरी कैलेंडर और हिब्रू कैलेंडर अलग-अलग ऐतिहासिक युगों और आरंभ बिंदुओं का उपयोग करते हैं। चूंकि प्रणालियां अलग-अलग माह अवधियों और अधिवर्ष नियमों का भी उपयोग करती हैं, इसलिए एक ही दिन के लिए संख्यात्मक तिथि स्वाभाविक रूप से भिन्न होती है।'
      ]
    },
    {
      q: 'पारंपरिक त्योहारों और पर्वों की तारीखें ग्रेगोरियन कैलेंडर पर हर साल क्यों बदलती हैं?',
      a: [
        'कई पारंपरिक सांस्कृतिक और धार्मिक त्योहार—जैसे दिवाली, ईद, पासओवर और चीनी नव वर्ष—सौर ग्रेगोरियन कैलेंडर के बजाय चांद्र या चांद्र-सौर कैलेंडरों के अनुसार निर्धारित होते हैं। चूंकि १२ चंद्र चक्रों का एक चांद्र वर्ष ३६५ दिनों के सौर वर्ष से लगभग १० से ११ दिन छोटा होता है, इसलिए ये त्योहार साल-दर-साल ग्रेगोरियन कैलेंडर के सापेक्ष आगे-पीछे होते रहते हैं, जबकि चांद्र-सौर कैलेंडर सौर वर्ष के साथ दीर्घकालिक सामंजस्य बनाए रखने के लिए अधिक मास का उपयोग करते हैं।'
      ]
    },
    {
      q: 'स्थान के आधार पर किसी कैलेंडर तिथि या पारंपरिक पर्व में एक दिन का अंतर क्यों हो सकता है?',
      a: [
        'कई पारंपरिक काल-गणना प्रणालियों में, तिथियां और त्योहारों का समय स्थानीय खगोलीय घटनाओं पर निर्भर करता है—जैसे किसी विशिष्ट शहर में सूर्योदय का समय या किसी क्षेत्र में नए अर्धचंद्र (हिलाल) का प्रत्यक्ष दर्शन। समय क्षेत्र (Timezone) के अंतर के कारण भी एक ही खगोलीय घटना अलग-अलग स्थानीय नागरिक तिथियों पर आ सकती है। सुसंगत रूपांतरण प्रदान करने के लिए, CheckYourCalendar मानकीकृत खगोलीय आधारों और प्रलेखित संदर्भ मानकों का उपयोग करता है।'
      ]
    },
    {
      q: 'CheckYourCalendar अपनी कैलेंडर गणनाओं में सटीकता कैसे सुनिश्चित करता है?',
      a: [
        'CheckYourCalendar स्थापित खगोलीय एल्गोरिदम, ओपन-सोर्स गणना लाइब्रेरी और मान्यता प्राप्त नागरिक मानकों का उपयोग करता है, जैसे इस्लामी तिथियों के लिए उम्म अल-कुरा मानक और भारतीय पंचांग के लिए मानक सौर-चांद्र गणना मॉडल। ये विधियां सुसंगत कैलेंडर गणना प्रदान करने के लिए बनाई गई हैं, यद्यपि कुछ धार्मिक या क्षेत्रीय पर्व स्थानीय प्राधिकारियों, चंद्र दर्शन या क्षेत्रीय परंपराओं का अनुसरण कर सकते हैं।'
      ]
    },
    {
      q: 'कैलेंडर तिथि और पर्व (Observance) में क्या अंतर है?',
      a: [
        'कैलेंडर तिथि किसी विशिष्ट प्रणाली के भीतर समय का एक गणितीय निर्देशांक है, जैसे कोई दिया गया दिन, माह और वर्ष। एक पर्व या त्योहार एक सांस्कृतिक उत्सव, धार्मिक पावन दिवस, व्रत, राष्ट्रीय अवकाश या अंतरराष्ट्रीय स्मरणोत्सव है जो निर्दिष्ट कैलेंडर निर्देशांकों पर आयोजित होता है। एक ही कैलेंडर तिथि पर विश्व की विभिन्न परंपराओं में कई पर्व हो सकते हैं।'
      ]
    }
  ],
  gu: [
    {
      q: 'વિવિધ કેલેન્ડર પ્રણાલીઓમાં આજની તારીખ કેવી રીતે જોવી અને સરખામણી કરવી?',
      a: [
        'જ્યારે આપ CheckYourCalendar ખોલો છો, ત્યારે હોમપેજ આપમેળે આપની સ્થાનિક તારીખ શોધી કાઢે છે અને તમામ સમર્થિત કેલેન્ડર પ્રણાલીઓમાં એકસાથે આજની તારીખ દર્શાવે છે. સૌર, ચાંદ્ર અને ચંદ્ર-સૌર પરંપરાઓમાં આજની તારીખની સાથે સાથે, આ પેજ આજના દિવસે આવતા મુખ્ય સાંસ્કૃતિક કે ધાર્મિક તહેવારો પણ દર્શાવે છે. આપ કેલેન્ડર પીકર દ્વારા કોઈપણ તારીખ પસંદ કરીને વિશ્વની વિવિધ પરંપરાઓમાં તેના નિર્દેશાંકો પણ જોઈ શકો છો.'
      ]
    },
    {
      q: 'CheckYourCalendar કઈ કેલેન્ડર પ્રણાલીઓને સમર્થન આપે છે?',
      a: [
        'CheckYourCalendar હાલમાં પ્રમાણભૂત ગ્રેગોરિયન કેલેન્ડર સાથે ૮ મુખ્ય ઐતિહાસિક, ધાર્મિક અને નાગરિક કેલેન્ડર પ્રણાલીઓ માટે તારીખ રૂપાંતરણ અને સાંસ્કૃતિક સંદર્ભ પ્રદાન કરે છે: વિક્રમ સંવત (ગુજરાતી/હિન્દુ), ઇસ્લામિક હિજરી, હિબ્રૂ, સૌર હિજરી (પર્શિયન), ભારતીય રાષ્ટ્રીય પંચાંગ (શક સંવત), ચાઇનીઝ પારંપરિક (ચંદ્ર-સૌર), કોપ્ટિક અને ઇથિયોપિયન કેલેન્ડર. સમય જતાં અન્ય કેલેન્ડર પ્રણાલીઓ પણ ઉમેરવામાં આવી શકે છે.'
      ]
    },
    {
      q: 'વિવિધ સમય-ગણતરી પ્રણાલીઓ વચ્ચે કેલેન્ડર રૂપાંતરણ કેવી રીતે કાર્ય કરે છે?',
      a: [
        'દરેક કેલેન્ડર પ્રણાલી સમયને એક ચોક્કસ ઐતિહાસિક પ્રારંભિક બિંદુ (યુગ/Epoch) થી માપે છે અને વિશિષ્ટ ખગોળીય કે નાગરિક નિયમોનું પાલન કરે છે. કેલેન્ડર રૂપાંતરણ તારીખને એક પ્રમાણભૂત સાર્વત્રિક સમય નિર્દેશાંકમાં રૂપાંતરિત કરીને કાર્ય કરે છે, અને પછી પ્રમાણિત ખગોળીય સૂત્રો અને અલ્ગોરિધમનો ઉપયોગ કરીને લક્ષિત કેલેન્ડરમાં સંબંધિત વર્ષ, મહિનો, દિવસ અને ચક્રની ગણતરી કરે છે.'
      ]
    },
    {
      q: 'સૌર, ચાંદ્ર અને ચંદ્ર-સૌર કેલેન્ડર પ્રણાલીઓ વચ્ચે શું તફાવત છે?',
      a: [
        'કેલેન્ડર પ્રણાલીઓને તેઓ જે ખગોળીય ચક્રને અનુસરે છે તેના આધારે વર્ગીકૃત કરવામાં આવે છે:',
        'સૌર કેલેન્ડરો (જેમ કે ગ્રેગોરિયન, પર્શિયન અને ભારતીય શક સંવત) પૃથ્વીની સૂર્ય પરિક્રમા (~૩૬૫.૨૪ દિવસ) ને અનુસરે છે જેથી તારીખો ઋતુચક્ર સાથે સુસંગત રહે.',
        'શુદ્ધ ચાંદ્ર કેલેન્ડરો (જેમ કે ઇસ્લામિક હિજરી કેલેન્ડર) ૧૨ ચંદ્ર કળા ચક્રો (~૩૫૪ દિવસ) ને અનુસરે છે, જેના કારણે તારીખો આશરે ૩૩ વર્ષના ચક્રમાં તમામ ઋતુઓમાં ફરે છે.',
        'ચંદ્ર-સૌર કેલેન્ડરો (જેમ કે હિન્દુ વિક્રમ સંવત, હિબ્રૂ અને ચાઇનીઝ કેલેન્ડર) ચંદ્ર માસને અનુસરે છે અને સૌર વર્ષ સાથે તાલમેલ જાળવવા સમયાંતરે અધિક માસ (લીપ મંથ) ઉમેરે છે.'
      ]
    },
    {
      q: 'એક જ દિવસ માટે જુદા જુદા કેલેન્ડરોમાં વર્ષ અને તારીખો કેમ અલગ હોય છે?',
      a: [
        'વિવિધ સંસ્કૃતિઓએ પોતાના કેલેન્ડરના પ્રારંભિક વર્ષ (યુગ) તરીકે વિવિધ ઐતિહાસિક, ખગોળીય કે આધ્યાત્મિક સીમાચિહ્નો નક્કી કર્યા છે. ઉદાહરણ તરીકે, ગ્રેગોરિયન કેલેન્ડર સામાન્ય યુગ (CE) નો ઉપયોગ કરે છે, જ્યારે વિક્રમ સંવત, ઇસ્લામિક હિજરી કેલેન્ડર અને હિબ્રૂ કેલેન્ડર અલગ ઐતિહાસિક યુગો અને પ્રારંભિક બિંદુઓનો ઉપયોગ કરે છે. કેલેન્ડર પ્રણાલીઓમાં મહિનાઓની લંબાઈ અને લીપ વર્ષના નિયમો પણ જુદા હોવાથી, એક જ દિવસ માટે સંખ્યાત્મક તારીખ સ્વાભાવિક રીતે અલગ હોય છે.'
      ]
    },
    {
      q: 'ગ્રેગોરિયન કેલેન્ડર પર પારંપરિક તહેવારોની તારીખ દર વર્ષે કેમ બદલાય છે?',
      a: [
        'દિવાળી, ઈદ, પાસઓવર અને ચાઇનીઝ નવું વર્ષ જેવા ઘણા પારંપરિક સાંસ્કૃતિક અને ધાર્મિક તહેવારો સૌર ગ્રેગોરિયન કેલેન્ડરને બદલે ચાંદ્ર કે ચંદ્ર-સૌર કેલેન્ડર મુજબ નક્કી થાય છે. ૧૨ ચંદ્ર ચક્રોનું ચાંદ્ર વર્ષ ૩૬૫ દિવસના સૌર વર્ષ કરતાં આશરે ૧૦ થી ૧૧ દિવસ નાનું હોવાથી, આ તહેવારો ગ્રેગોરિયન કેલેન્ડર પર દર વર્ષે વહેલા આવે છે, જ્યારે ચંદ્ર-સૌર કેલેન્ડરો સૌર વર્ષ સાથે દીર્ઘકાલીન સુમેળ માટે અધિક માસનો ઉપયોગ કરે છે.'
      ]
    },
    {
      q: 'સ્થળના આધારે કોઈ કેલેન્ડર તારીખ કે પારંપરિક તહેવારમાં એક દિવસનો તફાવત કેમ હોઈ શકે છે?',
      a: [
        'ઘણી પારંપરિક સમય-ગણતરી પ્રણાલીઓમાં, તારીખો અને તહેવારોનો સમય સ્થાનિક ખગોળીય ઘટનાઓ પર આધાર રાખે છે—જેમ કે કોઈ ચોક્કસ શહેરમાં સૂર્યોદયનો સમય અથવા કોઈ પ્રદેશમાં નવા ચંદ્ર (બીજ) નું પ્રત્યક્ષ દર્શન. ટાઇમ ઝોન (Timezone) ના તફાવતને કારણે પણ એક જ ખગોળીય ઘટના અલગ અલગ સ્થાનિક નાગરિક તારીખે આવી શકે છે. સુસંગત રૂપાંતરણ પ્રદાન કરવા માટે, CheckYourCalendar પ્રમાણભૂત ખગોળીય આધારો અને પ્રલેખિત સંદર્ભ ધોરણોનો ઉપયોગ કરે છે.'
      ]
    },
    {
      q: 'CheckYourCalendar પોતાની કેલેન્ડર ગણતરીઓમાં ચોકસાઈ કેવી રીતે સુનિશ્ચિત કરે છે?',
      a: [
        'CheckYourCalendar સ્થાપિત ખગોળીય અલ્ગોરિધમ, ઓપન-સોર્સ ગણતરી લાઇબ્રેરી અને માન્ય નાગરિક ધોરણોનો ઉપયોગ કરે છે, જેમ કે ઇસ્લામિક તારીખો માટે ઉમ્મ અલ-કુરા ધોરણ અને ભારતીય પંચાંગ માટે પ્રમાણભૂત સૂર્ય-ચંદ્ર ગણતરી મોડેલ. આ પદ્ધતિઓ સુસંગત કેલેન્ડર ગણતરી આપવા માટે રચાયેલી છે, જોકે કેટલાક ધાર્મિક કે પ્રાદેશિક તહેવારો સ્થાનિક સત્તાવાળાઓ, ચંદ્ર દર્શન કે સ્થાનિક પરંપરાઓને અનુસરી શકે છે.'
      ]
    },
    {
      q: 'કેલેન્ડર તારીખ અને પર્વ/તહેવાર (Observance) વચ્ચે શું તફાવત છે?',
      a: [
        'કેલેન્ડર તારીખ એ કોઈ ચોક્કસ પ્રણાલીમાં સમયનો ગાણિતિક નિર્દેશાંક છે, જેમ કે આપેલ દિવસ, મહિનો અને વર્ષ. પર્વ કે તહેવાર એ સાંસ્કૃતિક ઉત્સવ, ધાર્મિક પાવન દિવસ, વ્રત, રાષ્ટ્રીય રજા કે આંતરરાષ્ટ્રીય સ્મરણોત્સવ છે જે નિર્ધારિત કેલેન્ડર નિર્દેશાંકો પર આવે છે. એક જ કેલેન્ડર તારીખ પર વિશ્વની વિવિધ પરંપરાઓના એકથી વધુ પર્વો હોઈ શકે છે.'
      ]
    }
  ]
}[lang];
---

<Layout 
  title={t.about.title} 
  description={t.about.metaDesc}
  lang={lang}
>
  <Header activeTab="about" lang={lang} />

  <main class="container main-content">
    <article class="editorial-article">
      <header class="article-header">
        <h1 class="article-title">{lang === 'hi' ? 'CheckYourCalendar के बारे में' : 'CheckYourCalendar વિશે'}</h1>
        <p class="article-subtitle">
          {lang === 'hi' ? 'खगोलीय काल-गणना और सांस्कृतिक गाथाओं का सेतु' : 'ખગોળીય ગણતરીઓ અને સાંસ્કૃતિક વારસાનો સમન્વય'}
        </p>
      </header>

      <section class="article-body">
        <p class="lead">
          {lang === 'hi' 
            ? 'समय केवल एक संख्या नहीं है। प्रत्येक दिन का एक संदर्भ होता है और प्रत्येक तिथि का अपना इतिहास होता है। CheckYourCalendar का उद्देश्य आधुनिक समय-गणना और विभिन्न सांस्कृतिक परंपराओं के बीच एक सुदृढ़ सेतु बनाना है।'
            : 'સમય માત્ર એક અંક નથી. દરેક દિવસનો એક વિશેષ સંદર્ભ હોય છે અને દરેક તારીખનો પોતાનો ઇતિહાસ હોય છે. CheckYourCalendar નો હેતુ આધુનિક કેલેન્ડર ગણતરીઓ અને વિવિધ સંસ્કૃતિઓની સમૃદ્ધ પરંપરાઓ વચ્ચે સુમેળ સાધવાનો છે.'
          }
        </p>

        <h2>{lang === 'hi' ? 'हमारा उद्देश्य: तिथि अन्वेषण यात्रा' : 'અમારો ઉદ્દેશ્ય: તારીખ સંશોધન યાત્રા'}</h2>
        <p>
          {lang === 'hi' 
            ? 'हमारी सूचना संरचना चार स्पष्ट चरणों पर आधारित है:' 
            : 'અમારી માહિતી પ્રણાલી ચાર મહત્વપૂર્ણ તબક્કાઓ પર આધારિત છે:'}
        </p>
        <div class="mission-path">
          <div class="path-step">
            <span class="step-num">1</span>
            <strong>{lang === 'hi' ? 'तारीख' : 'તારીખ'}</strong>
            <p>{lang === 'hi' ? 'समय का एक विशिष्ट निर्देशांक' : 'સમયનો ચોક્કસ નિર્દેશાંક'}</p>
          </div>
          <div class="path-arrow"><span class="material-symbols-outlined">arrow_forward</span></div>
          <div class="path-step">
            <span class="step-num">2</span>
            <strong>{lang === 'hi' ? 'कैलेंडर' : 'કેલેન્ડર'}</strong>
            <p>{lang === 'hi' ? 'विभिन्न संस्कृतियों में तिथि का रूप' : 'વિવિધ સંસ્કૃતિઓમાં તારીખનું સ્વરૂપ'}</p>
          </div>
          <div class="path-arrow"><span class="material-symbols-outlined">arrow_forward</span></div>
          <div class="path-step">
            <span class="step-num">3</span>
            <strong>{lang === 'hi' ? 'पर्व व त्योहार' : 'તહેવારો અને વ્રત'}</strong>
            <p>{lang === 'hi' ? 'आज के दिन आने वाले उत्सव' : 'આજના દિવસે આવતા પર્વો'}</p>
          </div>
          <div class="path-arrow"><span class="material-symbols-outlined">arrow_forward</span></div>
          <div class="path-step">
            <span class="step-num">4</span>
            <strong>{lang === 'hi' ? 'अर्थ व संदर्भ' : 'અર્થ અને મહત્વ'}</strong>
            <p>{lang === 'hi' ? 'सांस्कृतिक एवं ऐतिहासिक पृष्ठभूमि' : 'સાંસ્કૃતિક અને ઐતિહાસિક પૃષ્ઠભૂમિ'}</p>
          </div>
        </div>

        <p>
          {lang === 'hi'
            ? 'CheckYourCalendar आपको त्वरित तिथि रूपांतरण देखने की सुविधा देता है, साथ ही मानव इतिहास और परंपराओं में उस दिन के वास्तविक महत्व को समझने का अवसर प्रदान करता है।'
            : 'CheckYourCalendar તમને ત્વરિત તારીખ રૂપાંતરણની સુવિધા આપવા ઉપરાંત માનવ ઇતિહાસ અને પરંપરાઓમાં આજના દિવસના સાચા મહત્વને સમજવાની તક આપે છે.'}
        </p>

        <h2 id="methodology">{lang === 'hi' ? 'काल-गणना पद्धति' : 'ગણતરી પદ્ધતિ'}</h2>
        <p>
          {lang === 'hi'
            ? 'कैलेंडर गणनाएं अत्यंत संवेदनशील और खगोलीय नियमों पर आधारित होती हैं। हम प्रमाणित गणितीय और खगोलीय एल्गोरिदम का उपयोग करते हैं:'
            : 'કેલેન્ડરની ગણતરીઓ અત્યંત સંવેદનશીલ અને ખગોળીય નિયમો પર આધારિત છે. અમે પ્રમાણિત ગાણિતિક અને ખગોળીય અલ્ગોરિધમનો ઉપયોગ કરીએ છીએ:'}
        </p>
        <ul>
          <li>
            <strong>{lang === 'hi' ? 'सौर कैलेंडर (Solar Calendars):' : 'સૌર કેલેન્ડરો (Solar Calendars):'}</strong> {lang === 'hi'
              ? 'ग्रेगोरियन, सौर हिजरी (फ़ारसी), भारतीय शक संवत, कॉप्टिक और इथियोपियाई कैलेंडर पृथ्वी की सूर्य परिक्रमा और संक्रांति गणनाओं पर आधारित हैं।'
              : 'ગ્રેગોરિયન, સૌર હિજરી (પર્શિયન), ભારતીય શક સંવત, કોપ્ટિક અને ઇથિયોપિયન કેલેન્ડરો પૃથ્વીની સૂર્ય પરિક્રમા અને સંક્રાંતિ ગણતરીઓ પર આધારિત છે.'}
          </li>
          <li>
            <strong>{lang === 'hi' ? 'चांद्र-सौर कैलेंडर (Lunisolar Calendars):' : 'ચંદ્ર-સૌર કેલેન્ડરો (Lunisolar Calendars):'}</strong> {lang === 'hi'
              ? 'विक्रम संवत (गुजराती/हिंदू), हिब्रू और चीनी पारंपरिक कैलेंडर चंद्र कलाओं (तिथियों) को सौर वर्ष के साथ सामंजस्य में रखने के लिए अधिक मास (Adhik Maas / Leap Month) का उपयोग करते हैं।'
              : 'વિક્રમ સંવત (ગુજરાતી/હિન્દુ), હિબ્રૂ અને ચાઇનીઝ કેલેન્ડરો ચંદ્ર કળા (તિથિ) અને ઋતુચક્રના તાલમેલ માટે અધિક માસ (Adhik Maas) પદ્ધતિ વાપરે છે.'}
          </li>
          <li>
            <strong>{lang === 'hi' ? 'विशुद्ध चांद्र कैलेंडर (Pure Lunar Calendars):' : 'શુદ્ધ ચાંદ્ર કેલેન્ડરો (Pure Lunar Calendars):'}</strong> {lang === 'hi'
              ? 'हिजरी (इस्लामी नागरिक) कैलेंडर में १२ चंद्र मास होते हैं (~३५४ दिन)। हमने मानक उम्म अल-कुरा नागरिक गणनाओं को आधार बनाया है।'
              : 'હિજરી (ઇસ્લામિક) કેલેન્ડરમાં ૧૨ ચંદ્ર માસ હોય છે (~૩૫૪ દિવસ). અમે પ્રમાણિત ઉમ્મ અલ-કુરા ગણતરીઓને આધાર બનાવી છે.'}
          </li>
        </ul>

        <h2>{lang === 'hi' ? 'शोध और प्रमाणिकता के मानक' : 'સંશોધન અને પ્રામાણિકતાના ધોરણો'}</h2>
        <p>
          {lang === 'hi'
            ? 'हम सांस्कृतिक और धार्मिक जानकारियों की सटीकता को सर्वोच्च प्राथमिकता देते हैं:'
            : 'અમે સાંસ્કૃતિક અને ધાર્મિક માહિતીની ચોકસાઈને સર્વોચ્ચ પ્રાથમિકતા આપીએ છીએ:'}
        </p>
        <ul>
          <li>
            <strong>{lang === 'hi' ? 'तथ्य-आधारित सामग्री:' : 'તથ્ય આધારિત માહિતી:'}</strong> {lang === 'hi'
              ? 'सभी विवरण और ऐतिहासिक संदर्भ शोधकर्ताओं द्वारा सत्यापित हैं।'
