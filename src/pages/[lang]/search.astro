---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CalendarRegistry } from '../../engines/calendar/registry';
import { ObservanceEngine } from '../../engines/observance/engine';
import { useTranslations } from '../../i18n/utils';
import { getLocalizedCalendarInfo } from '../../i18n/calendarTranslations';
import { getLocalizedObservance } from '../../i18n/observanceTranslations';
import type { Locale } from '../../i18n/types';

export async function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const allObservances = ObservanceEngine.getAllObservances();
const allAdapters = CalendarRegistry.getActiveAdapters().filter(a => a.id !== 'gregorian');

const searchIndex = [
  ...allAdapters.map(adapter => {
    const info = getLocalizedCalendarInfo(adapter.id);
    const title = info ? info.name[lang] : adapter.name;
    const desc = info ? info.description[lang] : `${adapter.name} calendar system.`;
    return {
      id: adapter.id,
      type: 'calendar',
      typeLabel: lang === 'hi' ? 'कैलेंडर प्रणाली' : 'કેલેન્ડર પ્રણાલી',
      title: title,
      link: `/${lang}/calendar/${adapter.id}`,
      description: desc,
      tags: [
        adapter.id,
        adapter.name.toLowerCase(),
        title.toLowerCase(),
        ...(info ? [info.type[lang].toLowerCase()] : [])
      ]
    };
  }),
  ...allObservances.map(obs => {
    const info = getLocalizedCalendarInfo(obs.calendar);
    const locObs = getLocalizedObservance(obs.id, lang);
    const title = locObs ? locObs.name : obs.name;
    const desc = locObs ? locObs.shortDescription : obs.shortDescription;
    const calName = info ? info.name[lang] : obs.calendar;
    const typeLabel = t.common.observanceTypes[obs.type as keyof typeof t.common.observanceTypes] || obs.type;

    return {
      id: obs.id,
      type: 'observance',
      typeLabel: typeLabel,
      title: title,
      link: `/${lang}/observance/${obs.id}`,
      description: desc,
      badge: obs.type,
      calendarName: calName,
      regionName: obs.regions.join(', ') || 'Global',
      tags: [
        obs.id,
        obs.name.toLowerCase(),
        title.toLowerCase(),
        obs.calendar.toLowerCase(),
        calName.toLowerCase(),
        ...obs.tags.map(tag => tag.toLowerCase()),
        ...obs.regions.map(r => r.toLowerCase())
      ]
    };
  })
];

const labels = {
  hi: {
    pageTitle: 'खोजें (Search)',
    pageIntro: 'किसी भी तिथि, त्योहार या कैलेंडर परंपरा की जानकारी और गणना खोजें।',
    placeholder: "खोजें: 'दीपावली', 'जन्माष्टमी', 'चीनी कैलेंडर', '2026-09-04'...",
    submit: 'खोजें',
    results: 'परिणाम',
    noResultsTitle: 'कोई परिणाम नहीं मिला',
    noResultsDesc: 'आपकी खोज से मेल खाता कोई परिणाम नहीं मिला। कृपया त्योहार का नाम या तिथि बदल कर देखें।',
    popularHeading: 'लोकप्रिय खोजें:',
    startTitle: 'खोजना प्रारंभ करें',
    startDesc: 'कैलेंडर, तिथियों और सांस्कृतिक पर्वों को खोजने के लिए ऊपर खोज शब्द दर्ज करें।'
  },
  gu: {
    pageTitle: 'શોધો (Search)',
    pageIntro: 'કોઈપણ તારીખ, તહેવાર કે કેલેન્ડર પરંપરાની વિગત અને ગણતરી શોધો.',
    placeholder: "શોધો: 'દિવાળી', 'જન્માષ્ટમી', 'ચાઇનીઝ કેલેન્ડર', '2026-09-04'...",
    submit: 'શોધો',
    results: 'પરિણામો',
    noResultsTitle: 'કોઈ પરિણામ મળ્યું નથી',
    noResultsDesc: 'આપની શોધ સાથે મેળ ખાતું કોઈ પરિણામ મળ્યું નથી. કૃપા કરીને તહેવારનું નામ કે તારીખ બદલીને પ્રયાસ કરો.',
    popularHeading: 'લોકપ્રિય શોધો:',
    startTitle: 'શોધ શરૂ કરો',
    startDesc: 'કેલેન્ડર, તારીખો અને સાંસ્કૃતિક પર્વો શોધવા માટે ઉપર શબ્દ દાખલ કરો.'
  }
}[lang];
---

<Layout 
  title={labels.pageTitle} 
  description={t.search.metaDesc}
  lang={lang}
>
  <Header activeTab="search" lang={lang} />

  <main class="container main-content">
    <section class="search-header">
      <h1 class="page-title">{labels.pageTitle}</h1>
      <p class="page-intro">{labels.pageIntro}</p>
    </section>

    <!-- Search Form -->
    <section class="search-form-section">
      <form action={`/${lang}/search`} method="GET" class="search-form-bar" id="search-form" data-lang={lang}>
        <span class="material-symbols-outlined input-icon">search</span>
        <input 
          type="search" 
          id="search-input"
          name="q" 
          placeholder={labels.placeholder} 
          class="main-search-input" 
          aria-label="Search site content"
          required
        />
        <button type="submit" class="submit-btn">{labels.submit}</button>
      </form>
    </section>

    <!-- Search Results / Empty State Container -->
    <section class="results-section">
      <!-- Active Results State -->
      <div id="results-container" class="results-container" style="display: none;">
        <h2 id="results-heading" class="results-heading">{labels.results}</h2>
        <div id="results-list" class="results-list"></div>
      </div>

      <!-- No Results State -->
      <div id="no-results-state" class="empty-state" style="display: none;">
        <span class="material-symbols-outlined empty-icon">search_off</span>
        <h2 class="empty-title">{labels.noResultsTitle}</h2>
        <p id="no-results-text" class="empty-description">
          {labels.noResultsDesc}
        </p>
        <div class="suggestions-box">
          <span class="suggestions-label">{labels.popularHeading}</span>
          <div class="suggestions-list">
            <a href={`/${lang}/search?q=Janmashtami`} class="suggestion-link">{lang === 'hi' ? 'जन्माष्टमी' : 'જન્માષ્ટમી'}</a>
            <a href={`/${lang}/search?q=Diwali`} class="suggestion-link">{lang === 'hi' ? 'दीपावली' : 'દિવાળી'}</a>
            <a href={`/${lang}/search?q=Hijri`} class="suggestion-link">{lang === 'hi' ? 'हिजरी' : 'હિજરી'}</a>
            <a href={`/${lang}/search?q=Coptic`} class="suggestion-link">{lang === 'hi' ? 'कॉप्टिक' : 'કોપ્ટિક'}</a>
          </div>
        </div>
      </div>

      <!-- Initial Empty State -->
      <div id="empty-state" class="empty-state">
        <span class="material-symbols-outlined empty-icon">manage_search</span>
        <h2 class="empty-title">{labels.startTitle}</h2>
        <p class="empty-description">{labels.startDesc}</p>
        
        <!-- Suggested Search Topics -->
        <div class="suggestions-box">
          <span class="suggestions-label">{labels.popularHeading}</span>
          <div class="suggestions-list">
            <a href={`/${lang}/search?q=Janmashtami`} class="suggestion-link">{lang === 'hi' ? 'जन्माष्टमी' : 'જન્માષ્ટમી'}</a>
            <a href={`/${lang}/search?q=Diwali`} class="suggestion-link">{lang === 'hi' ? 'दीपावली' : 'દિવાળી'}</a>
            <a href={`/${lang}/search?q=Chinese`} class="suggestion-link">{lang === 'hi' ? 'चीनी कैलेंडर' : 'ચાઇનીઝ કેલેન્ડર'}</a>
            <a href={`/${lang}/search?q=Hijri`} class="suggestion-link">{lang === 'hi' ? 'हिजरी' : 'હિજરી'}</a>
            <a href={`/${lang}/search?q=2026-09-04`} class="suggestion-link">2026-09-04</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Embed Search Index for Client-Side Filtering -->
  <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)} />

  <Footer lang={lang} />
</Layout>

<script>
  interface SearchItem {
    id: string;
    type: string;
    typeLabel: string;
    title: string;
    link: string;
    description: string;
    badge?: string;
    calendarName?: string;
    regionName?: string;
    tags: string[];
  }

  function initSearch() {
    const dataEl = document.getElementById('search-data');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const form = document.getElementById('search-form');
    const resultsContainer = document.getElementById('results-container');
    const resultsHeading = document.getElementById('results-heading');
    const resultsList = document.getElementById('results-list');
    const emptyState = document.getElementById('empty-state');
    const noResultsState = document.getElementById('no-results-state');
    const noResultsText = document.getElementById('no-results-text');

    if (!dataEl || !input || !form || !resultsContainer || !resultsHeading || !resultsList || !emptyState || !noResultsState) {
      return;
    }

    const pageLang = form.getAttribute('data-lang') || 'hi';
    let searchIndex: SearchItem[] = [];
    try {
      searchIndex = JSON.parse(dataEl.textContent || '[]');
    } catch (e) {
      console.error('Failed to parse search index:', e);
      return;
    }

    function performSearch(rawQuery: string) {
      const q = rawQuery.trim();
      input!.value = q;

      if (!q) {
        emptyState!.style.display = '';
        resultsContainer!.style.display = 'none';
        noResultsState!.style.display = 'none';
        return;
      }

      emptyState!.style.display = 'none';

      const qLower = q.toLowerCase();
      const tokens = qLower.split(/\s+/).filter(Boolean);

      // Check if query matches a date pattern (YYYY-MM-DD)
      const dateRegex = /^(\d{4})-(\d{1,2})-(\d{1,2})$/;
      const dateMatch = q.match(dateRegex);
      let dateResultCard = '';

      if (dateMatch) {
        const y = parseInt(dateMatch[1], 10);
        const m = parseInt(dateMatch[2], 10);
        const d = parseInt(dateMatch[3], 10);
        if (y === 2026 && m >= 1 && m <= 12 && d >= 1 && d <= 31) {
          const dateKey = `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          const jsDate = new Date(y, m - 1, d);
          const localeTag = pageLang === 'gu' ? 'gu-IN' : 'hi-IN';
          const formattedTitle = new Intl.DateTimeFormat(localeTag, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }).format(jsDate);
          const typeLabel = pageLang === 'gu' ? 'તારીખ નિર્દેશાંક' : 'तिथि खोज';
          const excerpt = pageLang === 'gu' 
            ? `${dateKey} માટે તમામ ૮ કેલેન્ડર પ્રણાલીઓમાં રૂપાંતરણ અને સાંસ્કૃતિક પર્વો.`
            : `${dateKey} के लिए सभी ८ कैलेंडर प्रणालियों में रूपांतरण और सांस्कृतिक पर्व।`;

          dateResultCard = `
            <div class="result-card">
              <span class="result-type">${typeLabel}</span>
              <h3 class="result-title">
                <a href="/${pageLang}/date/${dateKey}">${formattedTitle}</a>
              </h3>
              <p class="result-excerpt">${excerpt}</p>
            </div>
          `;
        }
      }

      // Filter search index
      const matched = searchIndex.filter(item => {
        const itemText = (
          item.title + ' ' +
          item.description + ' ' +
          (item.calendarName || '') + ' ' +
          (item.regionName || '') + ' ' +
          item.tags.join(' ')
        ).toLowerCase();

        return tokens.every(token => itemText.includes(token));
      });

      // Sort: exact matches first, then calendars, then observances
      matched.sort((a, b) => {
        const aExact = a.title.toLowerCase().includes(qLower) ? 1 : 0;
        const bExact = b.title.toLowerCase().includes(qLower) ? 1 : 0;
        if (aExact !== bExact) return bExact - aExact;
        if (a.type === 'calendar' && b.type !== 'calendar') return -1;
        if (b.type === 'calendar' && a.type !== 'calendar') return 1;
        return a.title.localeCompare(b.title);
      });

      const totalResults = matched.length + (dateResultCard ? 1 : 0);

      if (totalResults === 0) {
        resultsContainer!.style.display = 'none';
        noResultsState!.style.display = '';
        if (noResultsText) {
          noResultsText.textContent = pageLang === 'gu'
            ? `"${q}" માટે કોઈ પરિણામ મળ્યું નથી.`
            : `"${q}" के लिए कोई परिणाम नहीं मिला।`;
        }
      } else {
        noResultsState!.style.display = 'none';
        resultsContainer!.style.display = '';
        resultsHeading!.textContent = pageLang === 'gu'
          ? `"${q}" માટે ${totalResults} પરિણામ મળ્યા`
          : `"${q}" के लिए ${totalResults} परिणाम मिले`;

        let html = dateResultCard;
        for (const item of matched) {
          const metaInfo = item.calendarName ? `<span class="result-meta-item">${item.calendarName}</span>` : '';
          const regionInfo = item.regionName ? `<span class="result-meta-item">${item.regionName}</span>` : '';

          html += `
            <div class="result-card">
              <div class="result-header">
                <span class="result-type">${item.typeLabel}</span>
              </div>
              <h3 class="result-title">
                <a href="${item.link}">${item.title}</a>
              </h3>
              <p class="result-excerpt">${item.description}</p>
              ${metaInfo || regionInfo ? `<div class="result-meta">${metaInfo}${regionInfo}</div>` : ''}
            </div>
          `;
        }
        resultsList!.innerHTML = html;
      }
    }

    // Read query from URL on load
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';
    if (initialQuery) {
      performSearch(initialQuery);
    } else {
      emptyState!.style.display = '';
      resultsContainer!.style.display = 'none';
      noResultsState!.style.display = 'none';
    }

    // Handle form submission
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const query = input.value.trim();
      const newUrl = query ? `/${pageLang}/search?q=${encodeURIComponent(query)}` : `/${pageLang}/search`;
      window.history.pushState(null, '', newUrl);
      performSearch(query);
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', () => {
      const p = new URLSearchParams(window.location.search);
      performSearch(p.get('q') || '');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .search-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Form Bar */
  .search-form-section {
    width: 100%;
  }

  .search-form-bar {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .search-form-bar:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-container);
  }

  .input-icon {
    color: var(--color-on-surface-variant);
  }

  .main-search-input {
    border: none;
    background: transparent;
    width: 100%;
    color: var(--color-on-surface);
    font-size: 1rem;
    outline: none;
  }

  .submit-btn {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .submit-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  /* Results styling */
  .results-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .results-heading {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-on-surface-variant);
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .result-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .result-card:hover {
    background-color: var(--color-surface-container-low);
    border-color: var(--color-outline-variant);
  }

  .result-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .result-type {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-secondary);
    letter-spacing: 0.05em;
  }

  .result-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--color-primary);
  }

  .result-title a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .result-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .result-excerpt {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xs);
  }

  .result-meta-item {
    font-size: 0.75rem;
    background-color: var(--color-surface-dim);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    color: var(--color-on-surface-variant);
  }

  /* Empty state styling */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-xl) 0;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-outline-variant);
    border-radius: var(--radius-xl);
    gap: var(--spacing-sm);
  }

  .empty-icon {
    font-size: 4rem !important;
    color: var(--color-outline-variant);
  }

  .empty-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-on-surface);
  }

  .empty-description {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    max-width: 500px;
    line-height: 1.5;
  }

  .suggestions-box {
    margin-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .suggestions-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    letter-spacing: 0.05em;
  }

  .suggestions-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--spacing-xs);
  }

  .suggestion-link {
    background-color: var(--color-surface-dim);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-full);
    padding: 4px 12px;
    font-size: 0.8125rem;
    color: var(--color-primary);
    text-decoration: none;
  }

  .suggestion-link:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
    border-color: var(--color-primary);
  }
</style>
