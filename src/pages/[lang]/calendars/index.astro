---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { localizedCalendars } from '../../../i18n/calendarTranslations';
import type { Locale } from '../../../i18n/types';

export async function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<Layout 
  title={t.directories.calendarsTitle} 
  description={t.directories.calendarsMetaDesc}
  lang={lang}
>
  <Header activeTab="calendars" lang={lang} />

  <main class="container main-content">
    <section class="explorer-header">
      <h1 class="page-title">{t.directories.calendarsHeading}</h1>
      <p class="page-intro">
        {t.directories.calendarsIntro}
      </p>
    </section>

    <!-- Calendar List Feed -->
    <section class="calendars-feed">
      {localizedCalendars.map(cal => (
        <article class="calendar-detail-card" id={cal.id}>
          <div class="card-header">
            <h2 class="calendar-title">{cal.name[lang]}</h2>
            <span class="type-badge">{cal.type[lang]}</span>
          </div>
          
          <div class="card-content">
            <p class="description">{cal.description[lang]}</p>
            
            <div class="technical-details">
              <div class="detail-item">
                <span class="detail-label">{t.common.calculationCycle}</span>
                <p class="detail-value">{cal.cycleNote[lang]}</p>
              </div>
              <div class="detail-item">
                <span class="detail-label">{t.common.regionalVariations}</span>
                <p class="detail-value">{cal.variations[lang]}</p>
              </div>
            </div>
            
            <div class="action-footer">
              <a href={getLocalizedPath(`/calendar/${cal.id}`, lang)} class="explore-btn">
                <span class="material-symbols-outlined icon">calendar_month</span>
                {t.common.viewMonthCalendar}
              </a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .explorer-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  .calendars-feed {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .calendar-detail-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    scroll-margin-top: 100px;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .calendar-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .type-badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-secondary-container);
    color: var(--color-on-secondary-container);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .description {
    font-size: 0.9375rem;
    color: var(--color-on-background);
    line-height: 1.6;
  }

  .technical-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
    background-color: var(--color-surface-dim);
    padding: var(--spacing-md);
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--color-secondary);
  }

  .detail-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-secondary);
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-xs);
  }

  .detail-value {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .action-footer {
    display: flex;
    justify-content: flex-end;
  }

  .explore-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-sm);
  }

  .explore-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  .explore-btn .icon {
    font-size: 0.9375rem !important;
  }

  @media (min-width: 768px) {
    .technical-details {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
