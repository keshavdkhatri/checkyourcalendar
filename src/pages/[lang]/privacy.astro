---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

export async function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const content = {
  hi: {
    title: 'गोपनीयता नीति (Privacy Policy)',
    subtitle: 'डेटा उपयोग, एनालिटिक्स और कुकी प्रकटीकरण',
    lead: 'CheckYourCalendar बहु-कैलेंडर रूपांतरण, सांस्कृतिक पर्व और तिथि अन्वेषण की सुविधा प्रदान करता है। यह नीति स्पष्ट करती है कि वेबसाइट पर आने पर क्या जानकारी एकत्र होती है, एनालिटिक्स कैसे कार्य करता है और ईमेल पत्राचार का प्रबंधन कैसे किया जाता है।',
    h2Arch: 'वेबसाइट संरचना और डेटा भंडारण',
    pArch: 'CheckYourCalendar एक स्थिर (Static) वेबसाइट के रूप में संचालित होता है। हम कोई उपयोगकर्ता खाता, लॉगिन प्रणाली या विज़िटर डेटाबेस संचालित नहीं करते हैं। हमारी वेबसाइट पर कोई ऐसा वेब-फॉर्म नहीं है जो डेटाबेस में प्रविष्टियां संग्रहीत करता हो।',
    h2Analytics: 'वेबसाइट एनालिटिक्स',
    pAnalyticsIntro: 'हम साइट प्रदर्शन और विज़िटर उपयोग को समझने के लिए दो एनालिटिक्स प्रणालियों का उपयोग करते हैं:',
    liCloudflareTitle: 'Cloudflare Web Analytics:',
    liCloudflareText: 'हम ट्रैफ़िक और साइट प्रदर्शन को मापने के लिए Cloudflare Web Analytics का उपयोग करते हैं। Cloudflare के दस्तावेज़ों के अनुसार, यह समाधान गोपनीयता-केंद्रित है, माप के लिए कुकीज़ या क्लाइंट-साइड स्टोरेज का उपयोग नहीं करता है और व्यक्तिगत डेटा एकत्र नहीं करता है।',
    liGA4Title: 'Google Analytics 4:',
    liGA4Text: 'हम वेबसाइट उपयोग को समझने (जैसे लोकप्रिय पेज, सत्र अवधि, अनुमानित क्षेत्र और ब्राउज़र/डिवाइस प्रकार) के लिए Google Analytics 4 (GA4) का उपयोग करते हैं। मानक GA4 कार्यान्वयन उपयोग विश्लेषण के लिए फ़र्स्ट-पार्टी एनालिटिक्स कुकीज़ और पहचानकर्ताओं (जैसे _ga) का उपयोग करता है।',
    h2Cookies: 'कुकीज़ और पहचानकर्ता',
    pCookies: 'हमारी मूल कैलेंडर गणनाएं और तिथि रूपांतरण बिना किसी कुकी के सीधे आपके ब्राउज़र में चलते हैं। Cloudflare Web Analytics भी कुकीज़ का उपयोग नहीं करता है। यद्यपि, समग्र उपयोग आंकड़ों के मापन के लिए Google Analytics आपके डिवाइस पर फ़र्स्ट-पार्टी एनालिटिक्स कुकीज़ सेट करता है। आप अपनी ब्राउज़र सेटिंग्स के माध्यम से कुकीज़ को प्रबंधित या अक्षम कर सकते हैं।',
    h2Email: 'ईमेल पत्राचार',
    pEmail: 'वेबसाइट संपर्क संदेशों के लिए कोई खाता प्रणाली या डेटाबेस संचालित नहीं करती है। ईमेल द्वारा भेजे गए संदेश हमारी ईमेल सेवा के माध्यम से प्रबंधित किए जाते हैं। यदि आप ईमेल द्वारा हमसे संपर्क करते हैं, तो हम आपके संदेश का उत्तर देने, कैलेंडर से संबंधित रिपोर्ट की गई समस्याओं की जांच करने या सुझावों पर विचार करने के लिए आपके द्वारा प्रदान की गई जानकारी का उपयोग कर सकते हैं।',
    h2Security: 'डेटा सुरक्षा',
    pSecurity: 'चूंकि CheckYourCalendar बिना किसी उपयोगकर्ता खाते या वेब डेटाबेस के Cloudflare CDN पर स्थिर रूप से संचालित होता है, इसलिए हमारी वेबसाइट पर व्यक्तिगत क्रेडेंशियल या प्रोफ़ाइल डेटा संग्रहीत नहीं होता है।',
    h2Contact: 'गोपनीयता संबंधी प्रश्न व संपर्क',
    pContact: 'यदि इस गोपनीयता नीति या डेटा प्रकटीकरण के संबंध में आपका कोई प्रश्न है, तो कृपया हमसे संपर्क करें:'
  },
  gu: {
    title: 'ગોપનીયતા નીતિ (Privacy Policy)',
    subtitle: 'ડેટા વપરાશ, એનાલિટિક્સ અને કૂકી પ્રકટીકરણ',
    lead: 'CheckYourCalendar વિવિધ કેલેન્ડર રૂપાંતરણ, સાંસ્કૃતિક પર્વો અને તારીખ સંશોધનની સુવિધા આપે છે. આ નીતિ સ્પષ્ટ કરે છે કે વેબસાઇટની મુલાકાત વખતે કઈ માહિતી એકત્ર થાય છે, એનાલિટિક્સ કેવી રીતે કાર્ય કરે છે અને ઈમેલ પત્રવ્યવહાર કેવી રીતે સંભાળવામાં આવે છે.',
    h2Arch: 'વેબસાઇટ માળખું અને ડેટા સંગ્રહ',
    pArch: 'CheckYourCalendar સંપૂર્ણપણે સ્ટેટિક (Static) વેબસાઇટ તરીકે કાર્ય કરે છે. અમારી પાસે કોઈ યુઝર એકાઉન્ટ, લોગિન સિસ્ટમ કે વિઝિટર ડેટાબેઝ નથી. અમારી વેબસાઇટ પર કોઈ વેબ-ફોર્મ નથી જે ડેટાબેઝમાં માહિતી સંગ્રહિત કરતું હોય.',
    h2Analytics: 'વેબસાઇટ એનાલિટિક્સ',
    pAnalyticsIntro: 'અમે સાઇટ પ્રદર્શન અને મુલાકાતીઓના ટ્રાફિકને સમજવા માટે બે એનાલિટિક્સ સિસ્ટમનો ઉપયોગ કરીએ છીએ:',
    liCloudflareTitle: 'Cloudflare Web Analytics:',
    liCloudflareText: 'અમે સાઇટ પ્રદર્શન અને ટ્રાફિક માપવા Cloudflare Web Analytics નો ઉપયોગ કરીએ છીએ. Cloudflare ના દસ્તાવેજો મુજબ, આ એનાલિટિક્સ કૂકી-મુક્ત છે અને મુલાકાતીઓની વ્યક્તિગત માહિતી એકત્ર કરતું નથી.',
    liGA4Title: 'Google Analytics 4:',
    liGA4Text: 'અમે વેબસાઇટ વપરાશ (જેમ કે લોકપ્રિય પેજ, સેશન સમય, અંદાજિત વિસ્તાર અને બ્રાઉઝર/ડિવાઇસ પ્રકાર) સમજવા Google Analytics 4 (GA4) નો ઉપયોગ કરીએ છીએ. પ્રમાણભૂત GA4 સિસ્ટમ વિશ્લેષણ માટે ફર્સ્ટ-પાર્ટી એનાલિટિક્સ કૂકીઝ (જેમ કે _ga) નો ઉપયોગ કરે છે.',
    h2Cookies: 'કૂકીઝ અને ઓળખકર્તા',
    pCookies: 'અમારી મુખ્ય કેલેન્ડર ગણતરીઓ અને રૂપાંતરણો કૂકીઝ વિના સીધા આપના બ્રાઉઝરમાં થાય છે. Cloudflare Web Analytics પણ કૂકીઝ વાપરતું નથી. જોકે, મુલાકાતીઓના આંકડા સમજવા Google Analytics ફર્સ્ટ-પાર્ટી એનાલિટિક્સ કૂકીઝ સેટ કરે છે. આપ આપના બ્રાઉઝર સેટિંગ્સ દ્વારા કૂકીઝનું નિયંત્રણ કરી શકો છો.',
    h2Email: 'ઈમેલ પત્રવ્યવહાર',
    pEmail: 'વેબસાઇટ સંપર્ક સંદેશાઓ માટે કોઈ એકાઉન્ટ સિસ્ટમ કે ડેટાબેઝ ચલાવતી નથી. ઈમેલ દ્વારા મોકલવામાં આવેલા સંદેશાઓ અમારી ઈમેલ સેવા દ્વારા સંભાળવામાં આવે છે. જો આપ ઈમેલ દ્વારા અમારો સંપર્ક કરો છો, તો આપના સંદેશનો જવાબ આપવા, કેલેન્ડર સંબંધિત નોંધાયેલી સમસ્યાઓની તપાસ કરવા અથવા સૂચનો ધ્યાને લેવા માટે અમે આપે આપેલી માહિતીનો ઉપયોગ કરી શકીએ છીએ.',
    h2Security: 'ડેટા સુરક્ષા',
    pSecurity: 'CheckYourCalendar કોઈપણ યુઝર એકાઉન્ટ કે ડેટાબેઝ વિના Cloudflare CDN પર સ્ટેટિકલી કાર્ય કરે છે, તેથી સર્વર પર કોઈપણ વ્યક્તિગત વિગતો સંગ્રહિત થતી નથી.',
    h2Contact: 'ગોપનીયતા પ્રશ્નો અને સંપર્ક',
    pContact: 'આ ગોપનીયતા નીતિ અંગે કોઈ પ્રશ્ન હોય, તો કૃપા કરીને અમારો સંપર્ક કરો:'
  }
}[lang];
---

<Layout 
  title={t.privacy.title} 
  description={t.privacy.metaDesc}
  lang={lang}
>
  <Header lang={lang} />

  <main class="container main-content">
    <article class="editorial-article">
      <header class="article-header">
        <h1 class="article-title">{content.title}</h1>
        <p class="article-subtitle">{content.subtitle}</p>
      </header>

      <section class="article-body">
        <p class="lead">{content.lead}</p>

        <h2>{content.h2Arch}</h2>
        <p>{content.pArch}</p>

        <h2>{content.h2Analytics}</h2>
        <p>{content.pAnalyticsIntro}</p>
        <ul>
          <li>
            <strong>{content.liCloudflareTitle}</strong> {content.liCloudflareText}
          </li>
          <li>
            <strong>{content.liGA4Title}</strong> {content.liGA4Text}
          </li>
        </ul>

        <h2>{content.h2Cookies}</h2>
        <p>{content.pCookies}</p>

        <h2>{content.h2Email}</h2>
        <p>{content.pEmail}</p>

        <h2>{content.h2Security}</h2>
        <p>{content.pSecurity}</p>

        <h2>{content.h2Contact}</h2>
        <p>
          {content.pContact}
          <br />
          <a href="mailto:inquiries@checkyourcalendar.com"><strong>inquiries@checkyourcalendar.com</strong></a>
        </p>
      </section>
    </article>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }

  .editorial-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .article-header {
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    line-height: 1.15;
  }

  .article-subtitle {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-on-surface-variant);
    margin-top: var(--spacing-xs);
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-on-background);
    font-weight: 500;
  }

  .article-body h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-top: var(--spacing-md);
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-xs);
  }

  .article-body p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-on-background);
  }

  .article-body ul {
    list-style-type: square;
    padding-left: var(--spacing-lg);
    font-size: 0.9375rem;
    color: var(--color-on-background);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .article-body li {
    line-height: 1.6;
  }

  .article-body a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body a:hover {
    color: var(--color-primary-container);
  }

  .article-body code {
    background-color: var(--color-surface-dim);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
  }
</style>
