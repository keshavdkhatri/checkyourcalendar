---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/types';

export async function getStaticPaths() {
  return [
    { params: { lang: 'hi' } },
    { params: { lang: 'gu' } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const content = {
  hi: {
    title: 'गोपनीयता नीति (Privacy Policy)',
    subtitle: 'डेटा संग्रह, ट्रैकिंग और कुकी उपयोग संबंधी प्रकटीकरण',
    lead: 'आपकी गोपनीयता हमारे लिए अत्यंत महत्वपूर्ण है। CheckYourCalendar मुख्य कार्यप्रणाली के लिए व्यक्तिगत जानकारी एकत्र नहीं करता, उपयोगकर्ताओं को ट्रैक नहीं करता और न ही कुकीज़ संग्रहीत करता है।',
    h2Analytics: 'कुकी-मुक्त एनालिटिक्स',
    pAnalytics: 'हम साइट प्रदर्शन और ट्रैफ़िक को मापने के लिए Cloudflare Web Analytics का उपयोग करते हैं। यह समाधान गोपनीयता-अनुकूल और पूरी तरह से कुकी-मुक्त है।',
    h2Security: 'डेटा सुरक्षा',
    pSecurity: 'चूंकि CheckYourCalendar बिना किसी उपयोगकर्ता खाते, डेटाबेस या उपयोगकर्ता-प्रस्तुत सामग्री के पूरी तरह से स्थिर (Static) रूप से संचालित होता है, इसलिए किसी भी व्यक्तिगत जानकारी के अनधिकृत उपयोग का कोई जोखिम नहीं है।',
    h2Changes: 'भविष्य के परिवर्तन',
    pChanges: 'यदि हम भविष्य में कोई ऐसी सुविधा जोड़ते हैं जिसमें सहमति की आवश्यकता हो, तो हम इस नीति को अद्यतन करेंगे।'
  },
  gu: {
    title: 'ગોપનીયતા નીતિ (Privacy Policy)',
    subtitle: 'ડેટા સંગ્રહ, ટ્રેકિંગ અને કૂકી વપરાશ અંગેની માહિતી',
    lead: 'આપની ગોપનીયતા અમારા માટે અત્યંત મહત્વપૂર્ણ છે. CheckYourCalendar વ્યક્તિગત માહિતી એકત્રિત કરતું નથી, વપરાશકર્તાઓને ટ્રેક કરતું નથી કે કૂકીઝ સંગ્રહિત કરતું નથી.',
    h2Analytics: 'કૂકી-મુક્ત એનાલિટિક્સ',
    pAnalytics: 'અમે સાઇટ પ્રદર્શન અને મુલાકાતીઓના ટ્રાફિકને સમજવા માટે Cloudflare Web Analytics નો ઉપયોગ કરીએ છીએ. આ સુવિધા વપરાશકર્તાની ગોપનીયતાનું સન્માન કરે છે અને સંપૂર્ણપણે કૂકી-મુક્ત છે.',
    h2Security: 'ડેટા સુરક્ષા',
    pSecurity: 'CheckYourCalendar કોઈપણ યુઝર એકાઉન્ટ કે ડેટાબેઝ વિના સ્ટેટિકલી કાર્ય કરે છે, તેથી કોઈપણ વ્યક્તિગત વિગતો લીક થવાનું જોખમ રહેતું નથી.',
    h2Changes: 'ભાવિ ફેરફારો',
    pChanges: 'જો અમે ભવિષ્યમાં કોઈ નવી સુવિધા ઉમેરીશું જેમાં કૂકીઝની જરૂર પડે, તો અમે આ નીતિમાં સુધારો કરીશું.'
  }
}[lang];
---

<Layout 
  title={t.privacy.title} 
  description={t.privacy.metaDesc}
  lang={lang}
>
  <Header lang={lang} />

  <main class="container main-content">
    <article class="editorial-article">
      <header class="article-header">
        <h1 class="article-title">{content.title}</h1>
        <p class="article-subtitle">{content.subtitle}</p>
      </header>

      <section class="article-body">
        <p class="lead">{content.lead}</p>

        <h2>{content.h2Analytics}</h2>
        <p>{content.pAnalytics}</p>

        <h2>{content.h2Security}</h2>
        <p>{content.pSecurity}</p>

        <h2>{content.h2Changes}</h2>
        <p>{content.pChanges}</p>
      </section>
    </article>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }

  .editorial-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .article-header {
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    line-height: 1.15;
  }

  .article-subtitle {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-on-surface-variant);
    margin-top: var(--spacing-xs);
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-on-background);
    font-weight: 500;
  }

  .article-body h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-top: var(--spacing-md);
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-xs);
  }

  .article-body p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-on-background);
  }
</style>
