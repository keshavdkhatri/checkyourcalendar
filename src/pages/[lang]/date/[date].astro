---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import DateCompareGrid from '../../../components/DateCompareGrid.astro';
import ObservanceCard from '../../../components/ObservanceCard.astro';
import { CalendarRegistry } from '../../../engines/calendar/registry';
import { ObservanceEngine } from '../../../engines/observance/engine';
import { useTranslations, formatGregorianDate } from '../../../i18n/utils';
import { getLocalizedCalendarInfo, formatLocalizedCalendarDate } from '../../../i18n/calendarTranslations';
import { getLocalizedObservance } from '../../../i18n/observanceTranslations';
import type { Locale } from '../../../i18n/types';

export async function getStaticPaths() {
  const paths = [];
  const locales: Locale[] = ['hi', 'gu'];
  const start = new Date(2026, 0, 1);
  const end = new Date(2026, 11, 31);
  
  for (const lang of locales) {
    for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      const dateStr = `${y}-${m}-${day}`;
      paths.push({ params: { lang, date: dateStr } });
    }
  }
  return paths;
}

const { lang, date } = Astro.params as { lang: Locale; date: string };

// Parse the date (YYYY-MM-DD)
const [yearStr, monthStr, dayStr] = (date || '').split('-');
const parsedDate = {
  year: parseInt(yearStr, 10),
  month: parseInt(monthStr, 10),
  day: parseInt(dayStr, 10)
};

const t = useTranslations(lang);
const dateTitle = formatGregorianDate(parsedDate, lang);

const conversionsMap = CalendarRegistry.convert(parsedDate);
const dateConversions = Object.values(conversionsMap)
  .filter(c => c.calendar !== 'gregorian')
  .map(c => {
    const info = getLocalizedCalendarInfo(c.calendar);
    const calName = info ? info.name[lang] : c.calendar;
    return {
      calendarId: c.calendar,
      name: calName,
      dateString: formatLocalizedCalendarDate(c, lang)
    };
  });

const matchedObservances = ObservanceEngine.getObservancesForDate(parsedDate);
const dateObservances = matchedObservances.map(obs => {
  const info = getLocalizedCalendarInfo(obs.calendar);
  const locObs = getLocalizedObservance(obs.id, lang);
  return {
    id: obs.id,
    name: locObs ? locObs.name : obs.name,
    type: obs.type,
    calendarName: info ? info.name[lang] : obs.calendar,
    regionName: obs.regions.join(', ') || 'Global',
    summary: locObs ? locObs.shortDescription : obs.shortDescription,
    storyRef: obs.storyRef
  };
});

const prevDate = new Date(parsedDate.year, parsedDate.month - 1, parsedDate.day - 1);
const nextDate = new Date(parsedDate.year, parsedDate.month - 1, parsedDate.day + 1);

const prevDateStr = prevDate.getFullYear() === 2026
  ? `${prevDate.getFullYear()}-${String(prevDate.getMonth() + 1).padStart(2, '0')}-${String(prevDate.getDate()).padStart(2, '0')}`
  : null;
const nextDateStr = nextDate.getFullYear() === 2026
  ? `${nextDate.getFullYear()}-${String(nextDate.getMonth() + 1).padStart(2, '0')}-${String(nextDate.getDate()).padStart(2, '0')}`
  : null;

const breadcrumbDateDetail = lang === 'hi' ? 'तिथि विवरण' : 'તારીખ વિગત';
const dateSubtitle = lang === 'hi'
  ? 'इस तिथि पर विश्व कैलेंडरों में रूपांतरण और प्रमुख सांस्कृतिक पर्व'
  : 'આ તારીખે વિશ્વ કેલેન્ડરોમાં રૂપાંતરણ અને સાંસ્કૃતિક પર્વો';
const metaDescription = lang === 'hi'
  ? `${dateTitle} के लिए सभी प्रमुख कैलेंडर प्रणालियों में रूपांतरण और सांस्कृतिक पर्व।`
  : `${dateTitle} માટે તમામ મુખ્ય કેલેન્ડર પ્રણાલીઓમાં રૂપાંતરણ અને સાંસ્કૃતિક પર્વો.`;
---

<Layout 
  title={dateTitle} 
  description={metaDescription}
  lang={lang}
>
  <Header lang={lang} />

  <!-- Breadcrumbs -->
  <nav class="container breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li class="breadcrumb-item"><a href={`/${lang}`}>{t.common.breadcrumbsHome}</a></li>
      <li class="breadcrumb-item active" aria-current="page"><span class="material-symbols-outlined separator">chevron_right</span>{breadcrumbDateDetail}</li>
    </ol>
  </nav>

  <main class="container main-content">
    <section class="date-header">
      <div class="date-header-top">
        <div class="header-titles">
          <h1 class="date-title">{dateTitle}</h1>
          <p class="date-subtitle">{dateSubtitle}</p>
        </div>
        <div class="date-nav-controls">
          {prevDateStr ? (
            <a href={`/${lang}/date/${prevDateStr}`} class="date-nav-btn prev" title={t.common.yesterday}>
              <span class="material-symbols-outlined icon">arrow_back</span>
              <span>{t.common.yesterday}</span>
            </a>
          ) : (
            <span class="date-nav-btn disabled">
              <span class="material-symbols-outlined icon">arrow_back</span>
              <span>{t.common.start}</span>
            </span>
          )}

          {nextDateStr ? (
            <a href={`/${lang}/date/${nextDateStr}`} class="date-nav-btn next" title={t.common.tomorrow}>
              <span>{t.common.tomorrow}</span>
              <span class="material-symbols-outlined icon">arrow_forward</span>
            </a>
          ) : (
            <span class="date-nav-btn disabled">
              <span>{t.common.end}</span>
              <span class="material-symbols-outlined icon">arrow_forward</span>
            </span>
          )}
        </div>
      </div>
    </section>

    <!-- Content Grid -->
    <div class="content-grid">
      <!-- Conversions -->
      <div class="conversions-column">
        <h2 class="section-title">{lang === 'hi' ? 'कैलेंडर रूपांतरण' : 'કેલેન્ડર રૂપાંતરણ'}</h2>
        <DateCompareGrid conversions={dateConversions} lang={lang} />
      </div>

      <!-- Observances occurring today -->
      <div class="observances-column">
        <h2 class="section-title">{t.common.observancesOnDate}</h2>
        <div class="observances-list">
          {dateObservances.length > 0 ? (
            dateObservances.map(obs => (
              <ObservanceCard 
                id={obs.id}
                name={obs.name}
                type={obs.type}
                calendarName={obs.calendarName}
                regionName={obs.regionName}
                summary={obs.summary}
                storyRef={obs.storyRef}
                lang={lang}
              />
            ))
          ) : (
            <p class="no-observances">{t.common.noObservancesOnDate}</p>
          )}
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .breadcrumbs {
    padding-top: var(--spacing-md);
    padding-bottom: 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
  }

  .breadcrumb-item a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .breadcrumb-item.active {
    color: var(--color-on-background);
    font-weight: 500;
  }

  .separator {
    font-size: 1rem !important;
    margin: 0 4px;
    color: var(--color-outline-variant);
  }

  .main-content {
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .date-header {
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: var(--spacing-md);
  }

  .date-header-top {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .date-nav-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .date-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .date-nav-btn:hover:not(.disabled) {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
    border-color: var(--color-primary);
  }

  .date-nav-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .date-nav-btn .icon {
    font-size: 1rem !important;
  }

  .date-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .date-subtitle {
    font-size: 1rem;
    color: var(--color-on-surface-variant);
    margin-top: var(--spacing-xs);
  }

  @media (min-width: 768px) {
    .date-header-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  /* Grid details */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-on-surface);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-xs);
  }

  .conversions-column {
    display: flex;
    flex-direction: column;
  }

  .observances-column {
    display: flex;
    flex-direction: column;
  }

  .observances-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .no-observances {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    font-style: italic;
  }

  @media (min-width: 992px) {
    .content-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
