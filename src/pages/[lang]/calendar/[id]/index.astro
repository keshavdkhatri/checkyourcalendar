---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import { CalendarRegistry } from '../../../../engines/calendar/registry';
import { ObservanceEngine } from '../../../../engines/observance/engine';
import { useTranslations } from '../../../../i18n/utils';
import { getLocalizedCalendarInfo, formatLocalizedCalendarDate, toIndicDigits } from '../../../../i18n/calendarTranslations';
import { getLocalizedObservance } from '../../../../i18n/observanceTranslations';
import type { Locale } from '../../../../i18n/types';

export async function getStaticPaths() {
  const adapters = CalendarRegistry.getActiveAdapters().filter(a => a.id !== 'gregorian');
  const locales: Locale[] = ['hi', 'gu'];
  const paths = [];
  for (const lang of locales) {
    for (const adapter of adapters) {
      paths.push({
        params: { lang, id: adapter.id },
      });
    }
  }
  return paths;
}

const { lang, id } = Astro.params as { lang: Locale; id: string };
const adapter = CalendarRegistry.getAdapter(id || '');

if (!adapter) {
  return Astro.redirect(`/${lang}/404`);
}

const t = useTranslations(lang);
const info = getLocalizedCalendarInfo(adapter.id);
const calName = info ? info.name[lang] : adapter.name;

// Default to September 2026 for the initial calendar overview
const month = '2026-09';
const year = 2026;
const monthNum = 9;

const localeTag = lang === 'hi' ? 'hi-IN' : 'gu-IN';
const gregorianMonthName = new Intl.DateTimeFormat(localeTag, { month: 'long' }).format(new Date(year, monthNum - 1, 1));
const daysInMonth = new Date(year, monthNum, 0).getDate();

// Generate day conversions for this specific calendar
const days = [];
for (let d = 1; d <= daysInMonth; d++) {
  const dateObj = { year, month: monthNum, day: d };
  const jsDate = new Date(year, monthNum - 1, d);
  const dayOfWeek = jsDate.getDay();
  const converted = adapter.fromGregorian(dateObj);
  const formatted = formatLocalizedCalendarDate(converted, lang);
  const matchedObservances = ObservanceEngine.getObservancesForDate(dateObj, adapter.id);
  const observances = matchedObservances.map(obs => {
    const locObs = getLocalizedObservance(obs.id, lang);
    return {
      id: obs.id,
      name: locObs ? locObs.name : obs.name
    };
  });
  const dateKey = `${year}-${String(monthNum).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  const weekdayShort = new Intl.DateTimeFormat(localeTag, { weekday: 'short' }).format(jsDate);
  const weekdayLong = new Intl.DateTimeFormat(localeTag, { weekday: 'long' }).format(jsDate);

  days.push({
    dayNum: d,
    dayDisplay: toIndicDigits(d, lang),
    dayOfWeek,
    weekdayShort,
    weekdayLong,
    dateKey,
    converted,
    formatted,
    observances
  });
}

// Compute calendar month range representation
const firstDayConv = days[0].converted;
const lastDayConv = days[days.length - 1].converted;
let primaryMonthTitle = '';

const vikramMonthsMap: Record<number, { en: string; hi: string; gu: string }> = {
  1: { en: 'Kartak', hi: 'कार्तिक', gu: 'કાર્તક' },
  2: { en: 'Magsar', hi: 'मार्गशीर्ष', gu: 'માગશર' },
  3: { en: 'Pos', hi: 'पौष', gu: 'પોષ' },
  4: { en: 'Maha', hi: 'माघ', gu: 'મહા' },
  5: { en: 'Fagun', hi: 'फाल्गुन', gu: 'ફાગણ' },
  6: { en: 'Chaitra', hi: 'चैत्र', gu: 'ચૈત્ર' },
  7: { en: 'Vaishakh', hi: 'वैशाख', gu: 'વૈશાખ' },
  8: { en: 'Jeth', hi: 'ज्येष्ठ', gu: 'જેઠ' },
  9: { en: 'Ashadh', hi: 'आषाढ़', gu: 'અષાઢ' },
  10: { en: 'Shravan', hi: 'श्रावण', gu: 'શ્રાવણ' },
  11: { en: 'Bhadarvo', hi: 'भाद्रपद', gu: 'ભાદરવો' },
  12: { en: 'Aaso', hi: 'आश्विन', gu: 'આસો' },
};

if (adapter.id === 'hindu-vikram') {
  const m1 = (vikramMonthsMap[firstDayConv.month] || {})[lang] || firstDayConv.monthName;
  const m2 = (vikramMonthsMap[lastDayConv.month] || {})[lang] || lastDayConv.monthName;
  const eraLabel = lang === 'gu' ? 'વિ.સં.' : 'वि.सं.';
  if (firstDayConv.month === lastDayConv.month) {
    primaryMonthTitle = `${m1} ${toIndicDigits(firstDayConv.year, lang)} ${eraLabel}`;
  } else {
    primaryMonthTitle = `${m1} – ${m2} ${toIndicDigits(lastDayConv.year, lang)} ${eraLabel}`;
  }
} else {
  const m1 = firstDayConv.monthName || '';
  const m2 = lastDayConv.monthName || '';
  const yStr = toIndicDigits(lastDayConv.year, lang);
  let eraSuffix = '';
  if (adapter.id === 'islamic-civil') eraSuffix = lang === 'gu' ? ' હિજરી' : ' हिजरी';
  else if (adapter.id === 'hebrew') eraSuffix = lang === 'gu' ? ' હિબ્રૂ વર્ષ' : ' हिब्रू वर्ष';
  else if (adapter.id === 'persian') eraSuffix = lang === 'gu' ? ' સૌર હિજરી' : ' सौर हिजरी';
  else if (adapter.id === 'indian-saka') eraSuffix = lang === 'gu' ? ' શક સંવત' : ' शक संवत';
  else if (adapter.id === 'coptic') eraSuffix = lang === 'gu' ? ' એ.એમ.' : ' ए.एम.';
  else if (adapter.id === 'ethiopic') eraSuffix = lang === 'gu' ? ' ઈ.સી.' : ' ई.सी.';

  if (m1 === m2) {
    primaryMonthTitle = `${m1} ${yStr}${eraSuffix}`.trim();
  } else {
    primaryMonthTitle = `${m1} – ${m2} ${yStr}${eraSuffix}`.trim();
  }
}

// Month Navigation
const prevMonthStr = '2026-08';
const nextMonthStr = '2026-10';
const prevMonthName = new Intl.DateTimeFormat(localeTag, { month: 'long' }).format(new Date(2026, 7, 1));
const nextMonthName = new Intl.DateTimeFormat(localeTag, { month: 'long' }).format(new Date(2026, 9, 1));

// Available calendars for quick switching
const allAdapters = CalendarRegistry.getActiveAdapters().filter(a => a.id !== 'gregorian').map(ad => {
  const adInfo = getLocalizedCalendarInfo(ad.id);
  return {
    id: ad.id,
    name: adInfo ? adInfo.name[lang] : ad.name
  };
});

const pageTitle = `${calName} - ${gregorianMonthName} ${toIndicDigits(year, lang)}`;
const pageDesc = lang === 'hi'
  ? `${calName} के लिए दैनिक तिथि रूपांतरण, पंचांग विवरण और सांस्कृतिक पर्व (${gregorianMonthName} ${toIndicDigits(year, lang)})।`
  : `${calName} માટે દૈનિક તારીખ રૂપાંતરણ, પંચાંગ વિગતો અને તહેવારો (${gregorianMonthName} ${toIndicDigits(year, lang)}).`;
---

<Layout 
  title={pageTitle} 
  description={pageDesc}
  lang={lang}
>
  <Header activeTab="calendars" lang={lang} />

  <!-- Breadcrumbs -->
  <nav class="container breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li class="breadcrumb-item"><a href={`/${lang}`}>{t.common.breadcrumbsHome}</a></li>
      <li class="breadcrumb-item"><span class="material-symbols-outlined separator">chevron_right</span><a href={`/${lang}/calendars`}>{t.nav.calendars}</a></li>
      <li class="breadcrumb-item active" aria-current="page"><span class="material-symbols-outlined separator">chevron_right</span>{calName}</li>
    </ol>
  </nav>

  <main class="container main-content">
    <!-- Month Header & Summary -->
    <section class="month-header-card">
      <div class="header-left">
        <span class="calendar-badge">{calName}</span>
        <h1 class="month-title">{primaryMonthTitle}</h1>
        <p class="gregorian-range">
          {t.common.correspondingTo} {gregorianMonthName} {toIndicDigits(1, lang)} – {gregorianMonthName} {toIndicDigits(daysInMonth, lang)}, {toIndicDigits(year, lang)}
        </p>
      </div>

      <!-- Navigation buttons -->
      <div class="month-nav">
        <a href={`/${lang}/calendar/${adapter.id}/${prevMonthStr}`} class="nav-btn prev-btn" title={prevMonthName}>
          <span class="material-symbols-outlined icon">arrow_back</span>
          <span>{prevMonthName}</span>
        </a>

        <span class="current-month-label">{gregorianMonthName} {toIndicDigits(year, lang)}</span>

        <a href={`/${lang}/calendar/${adapter.id}/${nextMonthStr}`} class="nav-btn next-btn" title={nextMonthName}>
          <span>{nextMonthName}</span>
          <span class="material-symbols-outlined icon">arrow_forward</span>
        </a>
      </div>
    </section>

    <!-- Calendar System Switcher Pills -->
    <section class="calendar-switcher">
      <span class="switcher-label">{t.common.viewAnotherCalendar} {gregorianMonthName} {toIndicDigits(year, lang)}:</span>
      <div class="switcher-pills">
        {allAdapters.map(ad => (
          <a 
            href={`/${lang}/calendar/${ad.id}/${month}`} 
            class={`pill ${ad.id === adapter.id ? 'active' : ''}`}
          >
            {ad.name}
          </a>
        ))}
      </div>
    </section>

    <!-- Monthly Date Cards Grid -->
    <section class="month-grid-section">
      <h2 class="section-heading">{t.common.dailyConversions}</h2>
      
      <div class="days-list-grid">
        {days.map(d => {
          const isWeekend = d.dayOfWeek === 0 || d.dayOfWeek === 6;
          const hasObservances = d.observances.length > 0;
          
          return (
            <article class={`day-card ${isWeekend ? 'weekend' : ''} ${hasObservances ? 'has-observance' : ''}`}>
              <div class="day-card-header">
                <div class="gregorian-date-badge">
                  <span class="day-number">{d.dayDisplay}</span>
                  <span class="day-weekday">{d.weekdayShort}</span>
                </div>
                
                <a href={`/${lang}/date/${d.dateKey}`} class="day-detail-link" title={`/${lang}/date/${d.dateKey}`}>
                  <span>{t.common.allCalendars}</span>
                  <span class="material-symbols-outlined icon">north_east</span>
                </a>
              </div>

              <div class="converted-info">
                <span class="converted-label">{calName}</span>
                <p class="converted-date-str">{d.formatted}</p>
              </div>

              {hasObservances && (
                <div class="observances-section">
                  <span class="obs-header">{t.nav.observances}:</span>
                  <div class="obs-tags">
                    {d.observances.map(obs => (
                      <div class="obs-tag-item">
                        <a href={`/${lang}/observance/${obs.id}`} class="obs-name-link">
                          <span class="material-symbols-outlined obs-icon">event_note</span>
                          <span>{obs.name}</span>
                        </a>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .breadcrumbs {
    padding-top: var(--spacing-md);
    padding-bottom: 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
    flex-wrap: wrap;
  }

  .breadcrumb-item a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .breadcrumb-item.active {
    color: var(--color-on-background);
    font-weight: 500;
  }

  .separator {
    font-size: 1rem !important;
    margin: 0 4px;
    color: var(--color-outline-variant);
  }

  .main-content {
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  /* Month Header Card */
  .month-header-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .month-header-card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .calendar-badge {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-tertiary);
  }

  .month-title {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    color: var(--color-primary);
    line-height: 1.2;
    margin: var(--spacing-xs) 0;
  }

  .gregorian-range {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
  }

  /* Month Navigator */
  .month-nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background-color: var(--color-surface-dim);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-outline-variant);
    align-self: flex-start;
  }

  @media (min-width: 768px) {
    .month-nav {
      align-self: center;
    }
  }

  .current-month-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-on-surface);
    padding: 0 8px;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .nav-btn:hover {
    background-color: var(--color-surface);
    text-decoration: none;
  }

  .nav-btn:hover span:not(.icon) {
    text-decoration: underline;
  }

  .nav-btn .icon {
    font-size: 0.875rem !important;
  }

  /* Switcher Pills */
  .calendar-switcher {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .switcher-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-on-surface-variant);
  }

  .switcher-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .pill {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-on-surface);
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .pill:hover {
    background-color: var(--color-surface-dim);
    border-color: var(--color-primary);
  }

  .pill.active {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  /* Section Heading */
  .section-heading {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  /* Grid Layout for Month Days */
  .days-list-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .days-list-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .days-list-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .day-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .day-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgba(139, 74, 63, 0.06);
    transform: translateY(-2px);
  }

  .day-card.has-observance {
    border-left: 4px solid var(--color-secondary);
  }

  .day-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-xs);
  }

  .gregorian-date-badge {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .day-number {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .day-weekday {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    text-transform: uppercase;
  }

  .day-detail-link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .day-detail-link:hover {
    color: var(--color-primary);
    background-color: var(--color-surface-dim);
    text-decoration: none;
  }

  .day-detail-link:hover span:not(.icon) {
    text-decoration: underline;
  }

  .day-detail-link .icon {
    font-size: 0.75rem !important;
  }

  .converted-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .converted-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-on-surface-variant);
  }

  .converted-date-str {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-on-surface);
    line-height: 1.3;
  }

  /* Observances in Day Card */
  .observances-section {
    margin-top: auto;
    padding-top: var(--spacing-xs);
    border-top: 1px dashed var(--color-outline);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .obs-header {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
  }

  .obs-tags {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .obs-name-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary);
    text-decoration: none;
    line-height: 1.3;
  }

  .obs-name-link:hover {
    text-decoration: none;
  }

  .obs-name-link:hover span:not(.obs-icon) {
    text-decoration: underline;
  }

  .obs-icon {
    font-size: 0.875rem !important;
    color: var(--color-secondary);
    flex-shrink: 0;
  }
</style>
