---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import DateCompareGrid from '../../components/DateCompareGrid.astro';
import ObservanceCard from '../../components/ObservanceCard.astro';
import { CalendarRegistry } from '../../engines/calendar/registry';
import { ObservanceEngine } from '../../engines/observance/engine';

export async function getStaticPaths() {
  const paths = [];
  const start = new Date(2026, 0, 1);
  const end = new Date(2026, 11, 31);
  
  for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    const dateStr = `${y}-${m}-${day}`;
    paths.push({ params: { date: dateStr } });
  }
  return paths;
}

const { date } = Astro.params;

// Parse the date (YYYY-MM-DD)
const [yearStr, monthStr, dayStr] = date.split('-');
const parsedDate = {
  year: parseInt(yearStr, 10),
  month: parseInt(monthStr, 10),
  day: parseInt(dayStr, 10)
};

const jsDate = new Date(parsedDate.year, parsedDate.month - 1, parsedDate.day);
const dateTitle = new Intl.DateTimeFormat('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }).format(jsDate);

const conversionsMap = CalendarRegistry.convert(parsedDate);
const dateConversions = Object.values(conversionsMap)
  .filter(c => c.calendar !== 'gregorian')
  .map(c => {
    const adapter = CalendarRegistry.getAdapter(c.calendar)!;
    return {
      calendarId: c.calendar,
      name: adapter.name,
      dateString: adapter.format(c)
    };
  });

const matchedObservances = ObservanceEngine.getObservancesForDate(parsedDate);
const dateObservances = matchedObservances.map(obs => {
  const adapter = CalendarRegistry.getAdapter(obs.calendar)!;
  return {
    id: obs.id,
    name: obs.name,
    type: obs.type,
    calendarName: adapter.name,
    regionName: obs.regions.join(', ') || 'Global',
    summary: obs.shortDescription,
    storyRef: obs.storyRef
  };
});

const prevDate = new Date(parsedDate.year, parsedDate.month - 1, parsedDate.day - 1);
const nextDate = new Date(parsedDate.year, parsedDate.month - 1, parsedDate.day + 1);

const prevDateStr = prevDate.getFullYear() === 2026
  ? `${prevDate.getFullYear()}-${String(prevDate.getMonth() + 1).padStart(2, '0')}-${String(prevDate.getDate()).padStart(2, '0')}`
  : null;
const nextDateStr = nextDate.getFullYear() === 2026
  ? `${nextDate.getFullYear()}-${String(nextDate.getMonth() + 1).padStart(2, '0')}-${String(nextDate.getDate()).padStart(2, '0')}`
  : null;
---

<Layout title={dateTitle} description={`Explore calendar conversions and cultural observances for the date ${dateTitle}.`}>
  <Header />

  <!-- Breadcrumbs -->
  <nav class="container breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item active" aria-current="page"><span class="material-symbols-outlined separator">chevron_right</span>Date Detail</li>
    </ol>
  </nav>

  <main class="container main-content">
    <section class="date-header">
      <div class="date-header-top">
        <div class="header-titles">
          <h1 class="date-title">{dateTitle}</h1>
          <p class="date-subtitle">Global conversions and observances occurring on this date</p>
        </div>
        <div class="date-nav-controls">
          {prevDateStr ? (
            <a href={`/date/${prevDateStr}`} class="date-nav-btn prev" title="Go to previous day">
              <span class="material-symbols-outlined icon">arrow_back</span>
              <span>Yesterday</span>
            </a>
          ) : (
            <span class="date-nav-btn disabled">
              <span class="material-symbols-outlined icon">arrow_back</span>
              <span>Start</span>
            </span>
          )}

          {nextDateStr ? (
            <a href={`/date/${nextDateStr}`} class="date-nav-btn next" title="Go to next day">
              <span>Tomorrow</span>
              <span class="material-symbols-outlined icon">arrow_forward</span>
            </a>
          ) : (
            <span class="date-nav-btn disabled">
              <span>End</span>
              <span class="material-symbols-outlined icon">arrow_forward</span>
            </span>
          )}
        </div>
      </div>
    </section>

    <!-- Content Grid -->
    <div class="content-grid">
      <!-- Conversions -->
      <div class="conversions-column">
        <h2 class="section-title">Calendar Conversions</h2>
        <DateCompareGrid conversions={dateConversions} />
      </div>

      <!-- Observances occurring today -->
      <div class="observances-column">
        <h2 class="section-title">Observances on this Date</h2>
        <div class="observances-list">
          {dateObservances.length > 0 ? (
            dateObservances.map(obs => (
              <ObservanceCard 
                id={obs.id}
                name={obs.name}
                type={obs.type}
                calendarName={obs.calendarName}
                regionName={obs.regionName}
                summary={obs.summary}
                storyRef={obs.storyRef}
              />
            ))
          ) : (
            <p class="no-observances">No major cultural observances recorded for this date.</p>
          )}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .breadcrumbs {
    padding-top: var(--spacing-md);
    padding-bottom: 0;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
  }

  .breadcrumb-item a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .breadcrumb-item.active {
    color: var(--color-on-background);
    font-weight: 500;
  }

  .separator {
    font-size: 1rem !important;
    margin: 0 4px;
    color: var(--color-outline-variant);
  }

  .main-content {
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .date-header {
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: var(--spacing-md);
  }

  .date-header-top {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .date-nav-controls {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .date-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .date-nav-btn:hover:not(.disabled) {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
    border-color: var(--color-primary);
  }

  .date-nav-btn.disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .date-nav-btn .icon {
    font-size: 1rem !important;
  }

  .date-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    line-height: 1.2;
  }

  .date-subtitle {
    font-size: 1rem;
    color: var(--color-on-surface-variant);
    margin-top: var(--spacing-xs);
  }

  @media (min-width: 768px) {
    .date-header-top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  /* Grid details */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-on-surface);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-xs);
  }

  .conversions-column {
    display: flex;
    flex-direction: column;
  }

  .observances-column {
    display: flex;
    flex-direction: column;
  }

  .observances-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .no-observances {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    font-style: italic;
  }

  @media (min-width: 992px) {
    .content-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
