---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact" description="Get in touch with the team at CheckYourCalendar for general inquiries, calendar correction suggestions, or feedback.">
  <Header activeTab="contact" />

  <main class="container main-content">
    <section class="contact-section">
      <div class="contact-header">
        <h1 class="page-title">Contact Us</h1>
        <p class="page-intro">
          Have feedback, found a calendar discrepancy, or want to suggest a cultural observance? Use the form below to get in touch. We read every message.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="form-container">
          <form class="contact-form" action="#" method="POST">
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input type="text" id="name" name="name" class="form-input" required autocomplete="name" />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address</label>
              <input type="email" id="email" name="email" class="form-input" required autocomplete="email" />
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Subject</label>
              <select id="subject" name="subject" class="form-select" required>
                <option value="" disabled selected>Select a topic...</option>
                <option value="correction">Calendar Discrepancy / Correction</option>
                <option value="suggestion">Observance / Story Suggestion</option>
                <option value="feedback">General Feedback</option>
                <option value="other">Other Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message</label>
              <textarea id="message" name="message" class="form-textarea" rows="6" required></textarea>
            </div>

            <button type="submit" class="submit-btn">Send Message</button>
          </form>
        </div>

        <!-- Info Sidebar -->
        <aside class="info-sidebar">
          <div class="info-card">
            <h2 class="sidebar-title">Important Note on Calendar Data</h2>
            <p class="sidebar-text">
              Because timekeeping rules differ by astronomical cycles and cultural authorities, minor variances can occur. When suggesting corrections, please include:
            </p>
            <ul class="sidebar-list">
              <li>The calendar system in question</li>
              <li>The date and expected observance</li>
              <li>Authoritative sources (e.g., calculations, calendar councils, standard publications)</li>
            </ul>
          </div>
          
          <div class="info-card border-only">
            <h2 class="sidebar-title">Direct Contact</h2>
            <p class="sidebar-text">
              For general development inquiries, contact:
              <br />
              <strong>inquiries@checkyourcalendar.com</strong>
            </p>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .contact-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Grid Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .form-container {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    letter-spacing: 0.05em;
  }

  .form-input, .form-select, .form-textarea {
    background-color: var(--color-surface-dim);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    width: 100%;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--color-primary);
    background-color: var(--color-surface);
  }

  .submit-btn {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    align-self: flex-start;
  }

  .submit-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  /* Sidebar styling */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .info-card {
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }

  .info-card.border-only {
    background-color: transparent;
    border: 1px dashed var(--color-outline-variant);
  }

  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-text {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .sidebar-list {
    margin-top: var(--spacing-sm);
    padding-left: var(--spacing-md);
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
