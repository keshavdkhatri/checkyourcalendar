---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact" description="Get in touch with the team at CheckYourCalendar for general inquiries, calendar correction suggestions, or feedback.">
  <Header activeTab="contact" />

  <main class="container main-content">
    <section class="contact-section">
      <div class="contact-header">
        <h1 class="page-title">Contact Us</h1>
        <p class="page-intro">
          Have feedback, found a calendar discrepancy, or want to suggest a cultural observance? We welcome your input and read every message.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Main Contact Card -->
        <div class="contact-card">
          <div class="card-header-group">
            <h2 class="card-title">Get in Touch via Email</h2>
            <p class="card-desc">
              We handle all inquiries, calendar corrections, and observance suggestions directly via email. Clicking the button below will open your default email client with our address ready.
            </p>
          </div>

          <div class="action-group">
            <a 
              href="mailto:inquiries@checkyourcalendar.com" 
              class="email-btn"
              aria-label="Send an email to inquiries@checkyourcalendar.com"
            >
              <span class="material-symbols-outlined btn-icon" aria-hidden="true">mail</span>
              <span>Send Email</span>
            </a>
          </div>

          <div class="email-address-box">
            <span class="email-label">Or copy our email address:</span>
            <a href="mailto:inquiries@checkyourcalendar.com" class="email-address-value">inquiries@checkyourcalendar.com</a>
          </div>

          <div class="topics-guide">
            <h3 class="guide-title">What to Include in Your Email</h3>
            <div class="guide-grid">
              <div class="guide-item">
                <strong>Calendar Discrepancies & Corrections</strong>
                <p>Please specify the calendar system, exact date, and authoritative reference or calculation rule.</p>
              </div>
              <div class="guide-item">
                <strong>Observance & Festival Suggestions</strong>
                <p>Please share the festival name, calendar system, calculation rule or tithi, and cultural significance.</p>
              </div>
              <div class="guide-item">
                <strong>General Feedback & Technical Inquiries</strong>
                <p>Share usability suggestions, questions about our calculation engines, or report display issues.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Sidebar -->
        <aside class="info-sidebar">
          <div class="info-card">
            <h2 class="sidebar-title">Important Note on Calendar Data</h2>
            <p class="sidebar-text">
              Because timekeeping rules differ by astronomical cycles and cultural authorities, minor variances can occur. When suggesting corrections, please include:
            </p>
            <ul class="sidebar-list">
              <li>The calendar system in question</li>
              <li>The date and expected observance</li>
              <li>Authoritative sources (e.g., calculations, calendar councils, standard publications)</li>
            </ul>
          </div>
          
          <div class="info-card border-only">
            <h2 class="sidebar-title">Direct Contact</h2>
            <p class="sidebar-text">
              For editorial and technical inquiries:
              <br />
              <a href="mailto:inquiries@checkyourcalendar.com" class="sidebar-email">
                <strong>inquiries@checkyourcalendar.com</strong>
              </a>
            </p>
          </div>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
  }

  .contact-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .contact-header {
    max-width: 800px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  /* Grid Layout */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    align-items: start;
  }

  .contact-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .card-header-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  .card-desc {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  .action-group {
    padding-top: var(--spacing-xs);
  }

  .email-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: var(--radius-sm);
    padding: var(--spacing-sm) var(--spacing-lg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .email-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  .email-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-icon {
    font-size: 1.25rem !important;
  }

  .email-address-box {
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-surface-dim);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs) var(--spacing-sm);
  }

  .email-label {
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
  }

  .email-address-value {
    font-family: var(--font-sans);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.9375rem;
    user-select: all;
  }

  .email-address-value:hover {
    color: var(--color-primary-container);
  }

  .topics-guide {
    margin-top: var(--spacing-sm);
    border-top: 1px solid var(--color-outline-variant);
    padding-top: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .guide-grid {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .guide-item {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-on-surface-variant);
  }

  .guide-item strong {
    color: var(--color-on-surface);
    display: block;
    margin-bottom: 2px;
    font-size: 0.875rem;
  }

  .guide-item p {
    margin: 0;
  }

  /* Sidebar styling */
  .info-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .info-card {
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }

  .info-card.border-only {
    background-color: transparent;
    border: 1px dashed var(--color-outline-variant);
  }

  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-text {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.5;
  }

  .sidebar-email {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sidebar-email:hover {
    color: var(--color-primary-container);
  }

  .sidebar-list {
    margin-top: var(--spacing-sm);
    padding-left: var(--spacing-md);
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
