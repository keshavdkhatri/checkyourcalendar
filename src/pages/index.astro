---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DateCompareGrid from '../components/DateCompareGrid.astro';
import ObservanceCard from '../components/ObservanceCard.astro';
import { CalendarRegistry } from '../engines/calendar/registry';
import { ObservanceEngine } from '../engines/observance/engine';

// Default reference date computed at build time (bounded to 2026 range)
const buildDate = new Date();
let buildYear = buildDate.getFullYear();
let buildMonth = buildDate.getMonth() + 1;
let buildDay = buildDate.getDate();

if (buildYear !== 2026) {
  buildYear = 2026;
  buildMonth = 8;
  buildDay = 26;
}

const defaultDate = { year: buildYear, month: buildMonth, day: buildDay };

const jsDate = new Date(defaultDate.year, defaultDate.month - 1, defaultDate.day);
const todayGregorian = new Intl.DateTimeFormat('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }).format(jsDate);

const conversionsMap = CalendarRegistry.convert(defaultDate);
const conversions = Object.values(conversionsMap)
  .filter(c => c.calendar !== 'gregorian')
  .map(c => {
    const adapter = CalendarRegistry.getAdapter(c.calendar)!;
    return {
      calendarId: c.calendar,
      name: adapter.name,
      dateString: adapter.format(c)
    };
  });

const matchedObservances = ObservanceEngine.getObservancesForDate(defaultDate);
const observances = matchedObservances.map(obs => {
  const adapter = CalendarRegistry.getAdapter(obs.calendar)!;
  return {
    id: obs.id,
    name: obs.name,
    type: obs.type,
    calendarName: adapter.name,
    regionName: obs.regions.join(', ') || 'Global',
    summary: obs.shortDescription,
    storyRef: obs.storyRef
  };
});
---

<Layout
  title="Today's Date Across Calendars"
  description="Check today's date across multiple calendar systems and explore the dates, observances, and traditions that make each day meaningful."
>
  <Header activeTab="today" />

  <main class="container main-content">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-info">
        <div class="demo-tag-container">
          <span class="demo-badge">Featured Date</span>
        </div>
        <h1 class="date-title">{todayGregorian}</h1>
        <p class="hero-tagline">Know the date. Know the day. Know why it matters.</p>
        
        <!-- Date Lookup Selector (Explicit DD/MM/YYYY Format) -->
        <div class="search-box">
          <button
            type="button"
            class="calendar-trigger-btn"
            id="calendar-icon-trigger"
            aria-label="Open calendar picker"
            title="Open calendar picker"
          >
            <span class="material-symbols-outlined search-icon">calendar_month</span>
          </button>

          <form class="search-form" id="date-lookup-form" novalidate>
            <input
              type="text"
              id="date-lookup-display"
              class="search-input"
              inputmode="numeric"
              placeholder="DD/MM/YYYY"
              aria-label="Explore date in DD/MM/YYYY format"
              maxlength="10"
              autocomplete="off"
              value={`${String(defaultDate.day).padStart(2, '0')}/${String(defaultDate.month).padStart(2, '0')}/${defaultDate.year}`}
            />

            <!-- Hidden native date picker synced for device calendar dialog -->
            <input
              type="date"
              id="date-native-picker"
              tabindex="-1"
              aria-hidden="true"
              min="2026-01-01"
              max="2026-12-31"
              value={`${defaultDate.year}-${String(defaultDate.month).padStart(2, '0')}-${String(defaultDate.day).padStart(2, '0')}`}
              class="native-date-hidden"
            />

            <button type="submit" class="search-btn">Go</button>
          </form>
        </div>
      </div>

      <!-- Bento Grid Conversions -->
      <div class="hero-conversions">
        <DateCompareGrid conversions={conversions} />
      </div>
    </section>

    <hr class="divider" />

    <!-- Two Column Feed and Spotlight -->
    <section class="content-feed">
      <div class="observances-column">
        <h2 class="section-title">
          <span class="material-symbols-outlined section-icon">event_note</span>
          Today's Observances
        </h2>
        <div class="observances-list">
          {observances.length > 0 ? (
            observances.map(obs => (
              <ObservanceCard 
                id={obs.id}
                name={obs.name}
                type={obs.type}
                calendarName={obs.calendarName}
                regionName={obs.regionName}
                summary={obs.summary}
                storyRef={obs.storyRef}
              />
            ))
          ) : (
            <p class="no-observances">No major cultural observances recorded for today.</p>
          )}
        </div>
      </div>

      <!-- Spotlight Sidebar -->
      <div class="spotlight-column">
        <h2 class="section-title">
          <span class="material-symbols-outlined section-icon">insights</span>
          Today's Meaning
        </h2>
        <aside class="spotlight-card">
          <h3 class="spotlight-title">Why Today Matters</h3>
          <p class="spotlight-text">
            Today marks a unique intersection in celestial timekeeping. The alignment of these multiple calendar systems today highlights the shared human endeavor to track solar transitions, lunar cycles, and cultural milestones across traditions.
          </p>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  function parseDisplayToIso(str: string): string | null {
    const trimmed = str.trim();
    const match = trimmed.match(/^(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})$/);
    if (!match) return null;
    const d = parseInt(match[1], 10);
    const m = parseInt(match[2], 10);
    const y = parseInt(match[3], 10);

    if (y !== 2026) return null;
    if (m < 1 || m > 12) return null;

    const daysInMonth = new Date(2026, m, 0).getDate();
    if (d < 1 || d > daysInMonth) return null;

    return `2026-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
  }

  function isoToDisplay(iso: string): string {
    const [y, m, d] = iso.split('-');
    return `${d}/${m}/${y}`;
  }

  async function initHomepage() {
    const form = document.getElementById('date-lookup-form') as HTMLFormElement | null;
    const displayInput = document.getElementById('date-lookup-display') as HTMLInputElement | null;
    const nativePicker = document.getElementById('date-native-picker') as HTMLInputElement | null;
    const trigger = document.getElementById('calendar-icon-trigger');

    if (!form || !displayInput || !nativePicker) return;

    // 1. Determine local today's date in YYYY-MM-DD
    const now = new Date();
    let year = now.getFullYear();
    let month = now.getMonth() + 1;
    let day = now.getDate();

    // Bound to 2026 since that is the supported static range
    if (year !== 2026) {
      year = 2026;
      month = 8;
      day = 26;
    }

    const todayIso = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
    const todayDisplay = `${String(day).padStart(2, '0')}/${String(month).padStart(2, '0')}/${year}`;

    // Set synchronized initial values
    displayInput.value = todayDisplay;
    nativePicker.value = todayIso;

    // 2. Fetch conversions and observances for today
    try {
      const response = await fetch(`/date/${todayIso}`);
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      const html = await response.text();
      
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      // Update date title
      const newTitle = doc.querySelector('.date-title');
      const currentTitle = document.querySelector('.date-title');
      if (newTitle && currentTitle) {
        currentTitle.textContent = newTitle.textContent;
      }
      
      // Update conversions grid
      const newBentoGrid = doc.querySelector('.calendar-bento-grid');
      const currentHeroConversions = document.querySelector('.hero-conversions');
      if (newBentoGrid && currentHeroConversions) {
        currentHeroConversions.innerHTML = '';
        currentHeroConversions.appendChild(newBentoGrid);
      }
      
      // Update observances list
      const newObservancesList = doc.querySelector('.observances-list');
      const currentObservancesList = document.querySelector('.observances-list');
      if (newObservancesList && currentObservancesList) {
        currentObservancesList.innerHTML = newObservancesList.innerHTML;
      }
      
      // 3. Update the Spotlight section dynamically
      const spotlightText = document.querySelector('.spotlight-text');
      if (spotlightText) {
        if (todayIso === '2026-08-24') {
          spotlightText.textContent = `Today marks a unique intersection in celestial timekeeping. The 11th tithi (Ekadashi) in the lunar cycle coincides with the late summer monsoon transition in South Asia, a period historically associated with purification and renewal. The alignment of these multiple calendar systems today highlights the shared human endeavor to track agricultural cycles and spiritual milestones.`;
        } else {
          spotlightText.textContent = `Today marks a unique intersection in celestial timekeeping. The alignment of these multiple calendar systems today highlights the shared human endeavor to track solar transitions, lunar cycles, and cultural milestones across traditions.`;
        }
      }
    } catch (err) {
      console.error('Error fetching today\'s date data:', err);
    }

    // 4. Synchronize native calendar picker to DD/MM/YYYY display
    nativePicker.addEventListener('change', () => {
      if (nativePicker.value) {
        displayInput.value = isoToDisplay(nativePicker.value);
      }
    });

    // 5. Synchronize display text input to native picker
    displayInput.addEventListener('input', () => {
      const iso = parseDisplayToIso(displayInput.value);
      if (iso) {
        nativePicker.value = iso;
      }
    });

    // 6. Calendar icon trigger opens native date picker popup
    if (trigger) {
      trigger.addEventListener('click', () => {
        try {
          if (typeof nativePicker.showPicker === 'function') {
            nativePicker.showPicker();
          } else {
            nativePicker.focus();
            nativePicker.click();
          }
        } catch (e) {
          nativePicker.focus();
          nativePicker.click();
        }
      });
    }

    // 7. Form Submit navigation logic (validates DD/MM/YYYY -> navigates to /date/YYYY-MM-DD)
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = displayInput.value.trim();
      const iso = parseDisplayToIso(val);
      if (iso) {
        window.location.href = `/date/${iso}`;
      } else {
        alert('Please enter a valid date in DD/MM/YYYY format between 01/01/2026 and 31/12/2026 (e.g. 03/09/2026).');
      }
    });
  }

  // Run initialisation
  initHomepage();
</script>

<style>
  .main-content {
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .demo-tag-container {
    margin-bottom: var(--spacing-xs);
  }

  .demo-badge {
    background-color: var(--color-tertiary-container);
    color: var(--color-on-tertiary-container);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    display: inline-block;
  }

  /* Hero Section styles */
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .hero-info {
    width: 100%;
  }

  .date-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    line-height: 1.15;
    color: var(--color-primary);
    margin-bottom: var(--spacing-xs);
  }

  .hero-tagline {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-on-surface-variant);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm) var(--spacing-md);
    margin-top: var(--spacing-lg);
    max-width: 450px;
    width: 100%;
  }

  .calendar-trigger-btn {
    background: transparent;
    border: none;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-on-surface-variant);
    transition: color 0.15s ease;
  }

  .calendar-trigger-btn:hover {
    color: var(--color-primary);
  }

  .search-icon {
    color: inherit;
    font-size: 1.25rem !important;
  }

  .search-form {
    display: flex;
    flex-grow: 1;
    align-items: center;
    gap: var(--spacing-sm);
    position: relative;
  }

  .native-date-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .search-input {
    border: none;
    background: transparent;
    width: 100%;
    color: var(--color-on-surface);
    font-size: 0.875rem;
  }

  /* Hide the native calendar picker indicator */
  .search-input::-webkit-calendar-picker-indicator {
    display: none;
    -webkit-appearance: none;
  }

  .search-input::placeholder {
    color: var(--color-on-surface-variant);
    opacity: 0.7;
  }

  .search-input:focus {
    outline: none;
  }

  .search-btn {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border: none;
    border-radius: var(--radius-sm);
    padding: 6px 16px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .search-btn:hover {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }

  .hero-conversions {
    width: 100%;
  }

  .divider {
    border: 0;
    border-top: 1px solid var(--color-outline-variant);
    opacity: 0.5;
  }

  /* Two Column Feed styles */
  .content-feed {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  .observances-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-on-surface);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .section-icon {
    color: var(--color-primary);
    font-size: 1.75rem !important;
  }

  .observances-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .no-observances {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant);
    font-style: italic;
  }

  .spotlight-column {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .spotlight-card {
    background-color: var(--color-surface-container-highest);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }

  .spotlight-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-outline-variant);
    padding-bottom: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .spotlight-text {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    line-height: 1.6;
  }

  .story-teaser-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .story-teaser-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(139, 74, 63, 0.08);
  }

  .image-placeholder {
    height: 150px;
    background-color: var(--color-surface-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-outline-variant);
  }

  .placeholder-icon {
    font-size: 3rem !important;
    color: var(--color-outline-variant);
  }

  .teaser-content {
    padding: var(--spacing-md);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .teaser-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .teaser-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-on-surface);
  }

  .teaser-excerpt {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant);
    margin-bottom: var(--spacing-xs);
  }

  .teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .teaser-link:hover {
    text-decoration: underline;
  }

  .teaser-link .link-icon {
    font-size: 0.9375rem !important;
  }

  @media (min-width: 768px) {
    .hero-section {
      flex-direction: row;
    }

    .hero-info {
      width: 50%;
    }

    .hero-conversions {
      width: 50%;
    }

    .date-title {
      font-size: 3rem;
    }
  }

  @media (min-width: 992px) {
    .content-feed {
      grid-template-columns: 2fr 1fr;
    }
  }
</style>
