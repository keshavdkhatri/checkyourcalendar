---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
}

const { 
  title, 
  description = "Check your calendar — and understand what today means across calendars, cultures, and traditions.", 
  canonicalUrl,
  type = 'website'
} = Astro.props;

const resolvedCanonical = canonicalUrl || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Primary Meta Tags -->
    <title>{title} | CheckYourCalendar</title>
    <meta name="title" content={`${title} | CheckYourCalendar`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={`${title} | CheckYourCalendar`} />
    <meta property="og:description" content={description} />
    <!-- OG Image placeholder will be configured later -->
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={`${title} | CheckYourCalendar`} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    
    <!-- Material Icons for UI icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "CheckYourCalendar",
      "url": "https://checkyourcalendar.com",
      "description": "Check your calendar — and understand what today means across calendars, cultures, and traditions.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://checkyourcalendar.com/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Design System Tokens */
  :root {
    --color-background: #fdfbf7;
    --color-on-background: #2c2724;
    
    --color-surface: #ffffff;
    --color-on-surface: #2c2724;
    --color-surface-dim: #f5efe8;
    --color-surface-bright: #ffffff;
    
    --color-surface-container-lowest: #ffffff;
    --color-surface-container-low: #faf5ee;
    --color-surface-container: #fdfbf7;
    --color-surface-container-high: #f0e9df;
    --color-surface-container-highest: #e6decb;
    
    --color-on-surface-variant: #6e635d;
    --color-outline: #eae4df;
    --color-outline-variant: #d5ccc4;
    
    --color-primary: #8b4a3f;
    --color-on-primary: #ffffff;
    --color-primary-container: #f5ded9;
    --color-on-primary-container: #4a1510;
    
    --color-secondary: #4a7065;
    --color-on-secondary: #ffffff;
    --color-secondary-container: #cee4de;
    --color-on-secondary-container: #0f2922;
    
    --color-tertiary: #9e7b4f;
    --color-on-tertiary: #ffffff;
    --color-tertiary-container: #fcead0;
    --color-on-tertiary-container: #331d05;
    
    --color-error: #ba1a1a;
    --color-on-error: #ffffff;
    --color-error-container: #ffdad6;
    --color-on-error-container: #93000a;
    
    /* Typography Font Stacks */
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    
    /* Border Radius */
    --radius-sm: 0.125rem;
    --radius-default: 0.25rem;
    --radius-md: 0.375rem;
    --radius-lg: 0.5rem;
    --radius-xl: 0.75rem;
    --radius-full: 9999px;
    
    /* Spacing Scale */
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 16px;
    --spacing-lg: 24px;
    --spacing-xl: 48px;
    
    --container-max: 1280px;
    --gutter: 24px;
  }

  /* Reset & Base Styles */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    background-color: var(--color-background);
    color: var(--color-on-background);
    font-family: var(--font-sans);
    line-height: 1.6;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  img, svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  button, input, select, textarea {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
  }

  /* Focus Indicator */
  *:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  /* Utility Grid and Containers */
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }

  /* Material Symbols Styling */
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    display: inline-block;
    vertical-align: middle;
    line-height: 1;
  }
</style>
